<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="definitions" name="User task assignment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.3" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="process" name="User task assignment" isExecutable="true">
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:userTask id="akceptacja" name="Akceptacja">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="=wniosek.przelozony" candidateUsers="anna, jan" candidateGroups="kierownicy, sekretariat" />
        <zeebe:taskSchedule dueDate="2027-01-15T12:00:00+01:00" followUpDate="=now() + duration(&quot;P1D&quot;)" />
        <zeebe:priorityDefinition priority="70" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:userTask id="sprawdzenie" name="Sprawdzenie">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition assignee="kierownik" />
        <zeebe:priorityDefinition priority="=pilnosc * 10" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="e" name="Koniec" />
    <bpmn:sequenceFlow id="f-s-akceptacja" sourceRef="s" targetRef="akceptacja" />
    <bpmn:sequenceFlow id="f-akceptacja-sprawdzenie" sourceRef="akceptacja" targetRef="sprawdzenie" />
    <bpmn:sequenceFlow id="f-sprawdzenie-e" sourceRef="sprawdzenie" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="30" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="akceptacja_di" bpmnElement="akceptacja">
        <dc:Bounds x="116" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sprawdzenie_di" bpmnElement="sprawdzenie">
        <dc:Bounds x="266" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="416" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f-s-akceptacja_di" bpmnElement="f-s-akceptacja">
        <di:waypoint x="66" y="70" />
        <di:waypoint x="116" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-akceptacja-sprawdzenie_di" bpmnElement="f-akceptacja-sprawdzenie">
        <di:waypoint x="216" y="70" />
        <di:waypoint x="266" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-sprawdzenie-e_di" bpmnElement="f-sprawdzenie-e">
        <di:waypoint x="366" y="70" />
        <di:waypoint x="416" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
