<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Normy" targetNamespace="https://codeberg.org/MarekDeja/ipm/diagramy/02">
  <bpmn:collaboration id="Collaboration_Normy">
    <bpmn:participant id="Participant_Biblioteka" name="Biblioteka uczelniana" processRef="Process_Wypozyczenie" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Wypozyczenie" name="Wypożyczenie międzybiblioteczne" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Czytelnik" name="Czytelnik">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zlozenie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System biblioteczny">
        <bpmn:flowNodeRef>Task_Rejestracja</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bibliotekarz" name="Bibliotekarz">
        <bpmn:flowNodeRef>Task_Sprawdzenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Dostepna</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Wskazanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zamowienie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Wskazany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Wyslane</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Potrzeba książki" />
    <bpmn:userTask id="Task_Zlozenie" name="Złożenie zamówienia" />
    <bpmn:serviceTask id="Task_Rejestracja" name="Rejestracja zamówienia" />
    <bpmn:userTask id="Task_Sprawdzenie" name="Sprawdzenie katalogów" />
    <bpmn:exclusiveGateway id="Gw_Dostepna" name="Czy książka dostępna lokalnie?" />
    <bpmn:userTask id="Task_Wskazanie" name="Wskazanie egzemplarza" />
    <bpmn:userTask id="Task_Zamowienie" name="Zamówienie w innej bibliotece" />
    <bpmn:endEvent id="End_Wskazany" name="Egzemplarz wskazany" />
    <bpmn:endEvent id="End_Wyslane" name="Zamówienie wysłane" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Zlozenie" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Zlozenie" targetRef="Task_Rejestracja" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Rejestracja" targetRef="Task_Sprawdzenie" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Sprawdzenie" targetRef="Gw_Dostepna" />
    <bpmn:sequenceFlow id="F5" name="tak" sourceRef="Gw_Dostepna" targetRef="Task_Wskazanie" />
    <bpmn:sequenceFlow id="F6" name="nie" sourceRef="Gw_Dostepna" targetRef="Task_Zamowienie" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Wskazanie" targetRef="End_Wskazany" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Zamowienie" targetRef="End_Wyslane" />
    <bpmn:textAnnotation id="Ann_Poufnosc">
      <bpmn:text>ISO/IEC 27001: dane czytelnika są poufne; formularz dostępny tylko po zalogowaniu</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Zapis">
      <bpmn:text>ISO 9001 (7.5): zamówienie zapisane jako udokumentowana informacja</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Kompetencje">
      <bpmn:text>ISO 9001 (7.2): bibliotekarz ma kompetencje do wyszukiwania w NUKAT</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann_Przekazanie">
      <bpmn:text>ISO/IEC 27001: do innej biblioteki trafiają tylko dane niezbędne do realizacji zamówienia</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A1" sourceRef="Ann_Poufnosc" targetRef="Task_Zlozenie" />
    <bpmn:association id="A2" sourceRef="Ann_Zapis" targetRef="Task_Rejestracja" />
    <bpmn:association id="A3" sourceRef="Ann_Kompetencje" targetRef="Task_Sprawdzenie" />
    <bpmn:association id="A4" sourceRef="Ann_Przekazanie" targetRef="Task_Zamowienie" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Normy">
      <bpmndi:BPMNShape id="Participant_Biblioteka_di" bpmnElement="Participant_Biblioteka" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1070" height="950" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Czytelnik_di" bpmnElement="Lane_Czytelnik" isHorizontal="true">
