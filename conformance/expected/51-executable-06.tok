tok 0.6 "Elements of language 0.6 in an executable document" executable

pool biblioteka "Biblioteka"
  start s "Zamówienie" message="Zamówienie" correlation="numer"
  service przyjmij "Przyjęcie zamówienia" type="przyjecie"
  end e "Przyjęto"

pool czytelnik "Czytelnik" max=10

pool hurtownia "Hurtownia"

choreography zakup "Zakup"
  start zs
  choreo zamowienie "Zamówienie" from=biblioteka to=hurtownia message="Zamówienie hurtowe"
  end ze
  flow zs -> zamowienie -> ze

flow s -> przyjmij -> e

message czytelnik -> s "Zamówienie" id=m-zamowienie

conversation wypozyczenie "Wypożyczenie" pools="czytelnik biblioteka" messages="m-zamowienie"
callconversation reklamacja "Reklamacja" pools="biblioteka hurtownia" collaboration=reklamacje
