<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PracaZAgentem" targetNamespace="https://codeberg.org/MarekDeja/ipm/diagramy/10">
  <bpmn:collaboration id="Collaboration_PracaZAgentem">
    <bpmn:participant id="Participant_Stanowisko" name="Modelowanie z agentem AI" processRef="Process_PracaZAgentem" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PracaZAgentem" name="Praca z agentem nad modelem BPMN" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Student" name="Student">
        <bpmn:flowNodeRef>Start_Opis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Polecenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Recenzja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Zgodny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Poprawka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Przyjety</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Agent AI">
        <bpmn:flowNodeRef>Task_Odczytanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Mapowanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zapis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Walidacja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Bledy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Poprawa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Poprawa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Skrypt" name="Skrypt bpmn.py">
        <bpmn:flowNodeRef>Task_Walidacja</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="DataObject_Opis" name="Opis procesu" />
    <bpmn:dataObjectReference id="DOR_Opis" name="Opis procesu (proces.md)" dataObjectRef="DataObject_Opis" />
    <bpmn:dataObject id="DataObject_Mapowanie" name="Mapowanie" />
    <bpmn:dataObjectReference id="DOR_Mapowanie" name="Mapowanie (mapowanie.md)" dataObjectRef="DataObject_Mapowanie" />
    <bpmn:dataObject id="DataObject_Recenzja" name="Recenzja" />
    <bpmn:dataObjectReference id="DOR_Recenzja" name="Recenzja (recenzja.md)" dataObjectRef="DataObject_Recenzja" />
    <bpmn:startEvent id="Start_Opis" name="Opis procesu gotowy" />
    <bpmn:userTask id="Task_Polecenie" name="Wpisanie polecenia" />
    <bpmn:serviceTask id="Task_Odczytanie" name="Odczytanie opisu i skilla">
      <bpmn:property id="Task_Odczytanie_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Odczytanie">
        <bpmn:sourceRef>DOR_Opis</bpmn:sourceRef>
        <bpmn:targetRef>Task_Odczytanie_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Mapowanie" name="Zapis mapowania">
      <bpmn:dataOutputAssociation id="DOA_Mapowanie">
        <bpmn:targetRef>DOR_Mapowanie</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Zapis" name="Zapis modelu .bpmn" />
    <bpmn:exclusiveGateway id="Gw_Walidacja" />
    <bpmn:serviceTask id="Task_Walidacja" name="Walidacja, układ i rysunek" />
    <bpmn:exclusiveGateway id="Gw_Bledy" name="Czy 0 błędów?" />
    <bpmn:exclusiveGateway id="Gw_Poprawa" />
    <bpmn:serviceTask id="Task_Poprawa" name="Poprawa modelu" />
    <bpmn:userTask id="Task_Recenzja" name="Recenzja modelu">
      <bpmn:property id="Task_Recenzja_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Recenzja">
        <bpmn:sourceRef>DOR_Mapowanie</bpmn:sourceRef>
        <bpmn:targetRef>Task_Recenzja_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_Recenzja">
        <bpmn:targetRef>DOR_Recenzja</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Zgodny" name="Czy model zgodny z opisem?" />
    <bpmn:userTask id="Task_Poprawka" name="Wpisanie polecenia poprawki" />
    <bpmn:endEvent id="End_Przyjety" name="Model przyjęty" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Opis" targetRef="Task_Polecenie" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Polecenie" targetRef="Task_Odczytanie" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Odczytanie" targetRef="Task_Mapowanie" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Mapowanie" targetRef="Task_Zapis" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Zapis" targetRef="Gw_Walidacja" />
    <bpmn:sequenceFlow id="F6" sourceRef="Gw_Walidacja" targetRef="Task_Walidacja" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Walidacja" targetRef="Gw_Bledy" />
    <bpmn:sequenceFlow id="F8" name="nie" sourceRef="Gw_Bledy" targetRef="Gw_Poprawa" />
    <bpmn:sequenceFlow id="F9" name="tak" sourceRef="Gw_Bledy" targetRef="Task_Recenzja" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_Poprawa" targetRef="Task_Poprawa" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Poprawa" targetRef="Gw_Walidacja" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Recenzja" targetRef="Gw_Zgodny" />
    <bpmn:sequenceFlow id="F13" name="tak" sourceRef="Gw_Zgodny" targetRef="End_Przyjety" />
    <bpmn:sequenceFlow id="F14" name="nie" sourceRef="Gw_Zgodny" targetRef="Task_Poprawka" />
    <bpmn:sequenceFlow id="F15" sourceRef="Task_Poprawka" targetRef="Gw_Poprawa" />
  </bpmn:process>
