tok 0.1 "Podprocesy"

start s
sub p "Poszukiwania w zasobie" loop
  start ps
  task a "Kwerenda w inwentarzu" parallel
  task b "Kwerenda w aktach" sequential
  end pe
  flow ps -> a -> b -> pe
call c "Wydanie kopii" process=wydanie compensation
end e terminate
eventsub w "Wycofanie wniosku"
  start ws "Wniosek wycofany" message="Wycofanie" noninterrupting
  task wt "Zamknięcie sprawy"
  end we compensate
flow ws -> wt -> we

flow s -> p -> c -> e
