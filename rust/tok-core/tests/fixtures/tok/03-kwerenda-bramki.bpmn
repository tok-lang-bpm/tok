        <dc:Bounds x="766" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="forma_di" bpmnElement="forma">
        <dc:Bounds x="916" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="email_di" bpmnElement="email">
        <dc:Bounds x="1016" y="30" width="100" height="80" />
