<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Recenzja" targetNamespace="https://codeberg.org/MarekDeja/ipm/diagramy/07">
  <bpmn:message id="Msg_Maszynopis" name="Maszynopis" />
  <bpmn:message id="Msg_Odmowa" name="Odmowa wydania" />
  <bpmn:message id="Msg_Zaproszenie" name="Zaproszenie do recenzji" />
  <bpmn:message id="Msg_Zgoda" name="Zgoda na recenzję" />
  <bpmn:message id="Msg_Wydruk" name="Wydruk maszynopisu" />
  <bpmn:message id="Msg_Recenzja" name="Recenzja" />
  <bpmn:message id="Msg_Uwagi" name="Uwagi recenzenta" />
  <bpmn:message id="Msg_Poprawiony" name="Poprawiony maszynopis" />
  <bpmn:message id="Msg_Decyzja" name="Decyzja o druku" />
  <bpmn:dataStore id="DataStore_Arkusz" name="Arkusz publikacji" />
  <bpmn:collaboration id="Collaboration_Recenzja">
    <bpmn:participant id="Participant_Wydawnictwo" name="Wydawnictwo uczelniane" processRef="Process_Recenzja" />
    <bpmn:participant id="Participant_Autor" name="Autor" />
    <bpmn:participant id="Participant_Recenzent" name="Recenzent" />
    <bpmn:messageFlow id="MF_Maszynopis" name="Maszynopis" sourceRef="Participant_Autor" targetRef="Start_Maszynopis" messageRef="Msg_Maszynopis" />
    <bpmn:messageFlow id="MF_Odmowa" name="Odmowa" sourceRef="End_Odmowa" targetRef="Participant_Autor" messageRef="Msg_Odmowa" />
    <bpmn:messageFlow id="MF_Zaproszenie" name="Zaproszenie" sourceRef="Task_Zaproszenie" targetRef="Participant_Recenzent" messageRef="Msg_Zaproszenie" />
    <bpmn:messageFlow id="MF_Zgoda" name="Zgoda" sourceRef="Participant_Recenzent" targetRef="Catch_Zgoda" messageRef="Msg_Zgoda" />
    <bpmn:messageFlow id="MF_Wydruk" name="Wydruk pocztą" sourceRef="Task_Wysylka" targetRef="Participant_Recenzent" messageRef="Msg_Wydruk" />
    <bpmn:messageFlow id="MF_Recenzja" name="Recenzja" sourceRef="Participant_Recenzent" targetRef="Catch_Recenzja" messageRef="Msg_Recenzja" />
    <bpmn:messageFlow id="MF_Uwagi" name="Uwagi" sourceRef="Task_Uwagi" targetRef="Participant_Autor" messageRef="Msg_Uwagi" />
    <bpmn:messageFlow id="MF_Poprawiony" name="Poprawiony maszynopis" sourceRef="Participant_Autor" targetRef="Catch_Poprawiony" messageRef="Msg_Poprawiony" />
    <bpmn:messageFlow id="MF_Decyzja" name="Decyzja" sourceRef="End_Druk" targetRef="Participant_Autor" messageRef="Msg_Decyzja" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Recenzja" name="Recenzja wydawnicza — jak jest" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Recenzja">
      <bpmn:lane id="Lane_Redaktor" name="Redaktor prowadzący">
        <bpmn:flowNodeRef>Start_Maszynopis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rejestracja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Wydruk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Przepisanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Uwagi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Poprawiony</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Porownanie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sekretarz" name="Sekretarz rady wydawniczej">
        <bpmn:flowNodeRef>Catch_Posiedzenie1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Poszukiwanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zaproszenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Zgoda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Wysylka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Recenzja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Posiedzenie2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Rada" name="Rada wydawnicza">
        <bpmn:flowNodeRef>Task_Kwalifikacja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Recenzja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Odmowa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zatwierdzenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Druk</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Maszynopis" name="Maszynopis wpłynął">
      <bpmn:messageEventDefinition id="Start_Maszynopis_def" messageRef="Msg_Maszynopis" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Rejestracja" name="Rejestracja maszynopisu w arkuszu">
      <bpmn:dataOutputAssociation id="DOA_Arkusz1">
        <bpmn:targetRef>DataStoreRef_Arkusz</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_Wydruk" name="Wydruk maszynopisu dla rady" />
    <bpmn:intermediateCatchEvent id="Catch_Posiedzenie1" name="Najbliższe posiedzenie rady">
      <bpmn:timerEventDefinition id="Catch_Posiedzenie1_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_Kwalifikacja" name="Kwalifikacja maszynopisu na posiedzeniu" />
    <bpmn:exclusiveGateway id="Gw_Recenzja" name="Czy skierować do recenzji?" />
    <bpmn:endEvent id="End_Odmowa" name="Autor powiadomiony o odmowie">
      <bpmn:messageEventDefinition id="End_Odmowa_def" messageRef="Msg_Odmowa" />
    </bpmn:endEvent>
    <bpmn:manualTask id="Task_Poszukiwanie" name="Poszukiwanie recenzenta" />
    <bpmn:sendTask id="Task_Zaproszenie" name="Wysłanie zaproszenia do recenzji" messageRef="Msg_Zaproszenie" />
    <bpmn:intermediateCatchEvent id="Catch_Zgoda" name="Zgoda recenzenta otrzymana">
      <bpmn:messageEventDefinition id="Catch_Zgoda_def" messageRef="Msg_Zgoda" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_Wysylka" name="Wysłanie wydruku pocztą" />
    <bpmn:intermediateCatchEvent id="Catch_Recenzja" name="Recenzja otrzymana">
      <bpmn:messageEventDefinition id="Catch_Recenzja_def" messageRef="Msg_Recenzja" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Przepisanie" name="Przepisanie uwag recenzenta do arkusza">
      <bpmn:dataOutputAssociation id="DOA_Arkusz2">
        <bpmn:targetRef>DataStoreRef_Arkusz</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_Uwagi" name="Przekazanie uwag autorowi" messageRef="Msg_Uwagi" />
    <bpmn:intermediateCatchEvent id="Catch_Poprawiony" name="Poprawiony maszynopis otrzymany">
      <bpmn:messageEventDefinition id="Catch_Poprawiony_def" messageRef="Msg_Poprawiony" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_Porownanie" name="Porównanie poprawek z uwagami" />
    <bpmn:intermediateCatchEvent id="Catch_Posiedzenie2" name="Kolejne posiedzenie rady">
      <bpmn:timerEventDefinition id="Catch_Posiedzenie2_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_Zatwierdzenie" name="Zatwierdzenie do druku na posiedzeniu" />
    <bpmn:endEvent id="End_Druk" name="Maszynopis zatwierdzony do druku">
      <bpmn:messageEventDefinition id="End_Druk_def" messageRef="Msg_Decyzja" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStoreRef_Arkusz" name="Arkusz publikacji" dataStoreRef="DataStore_Arkusz" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Maszynopis" targetRef="Task_Rejestracja" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Rejestracja" targetRef="Task_Wydruk" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Wydruk" targetRef="Catch_Posiedzenie1" />
    <bpmn:sequenceFlow id="F4" sourceRef="Catch_Posiedzenie1" targetRef="Task_Kwalifikacja" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Kwalifikacja" targetRef="Gw_Recenzja" />
    <bpmn:sequenceFlow id="F6" name="nie" sourceRef="Gw_Recenzja" targetRef="End_Odmowa" />
    <bpmn:sequenceFlow id="F7" name="tak" sourceRef="Gw_Recenzja" targetRef="Task_Poszukiwanie" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Poszukiwanie" targetRef="Task_Zaproszenie" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Zaproszenie" targetRef="Catch_Zgoda" />
    <bpmn:sequenceFlow id="F10" sourceRef="Catch_Zgoda" targetRef="Task_Wysylka" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Wysylka" targetRef="Catch_Recenzja" />
    <bpmn:sequenceFlow id="F12" sourceRef="Catch_Recenzja" targetRef="Task_Przepisanie" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Przepisanie" targetRef="Task_Uwagi" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Uwagi" targetRef="Catch_Poprawiony" />
    <bpmn:sequenceFlow id="F15" sourceRef="Catch_Poprawiony" targetRef="Task_Porownanie" />
    <bpmn:sequenceFlow id="F16" sourceRef="Task_Porownanie" targetRef="Catch_Posiedzenie2" />
    <bpmn:sequenceFlow id="F17" sourceRef="Catch_Posiedzenie2" targetRef="Task_Zatwierdzenie" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Zatwierdzenie" targetRef="End_Druk" />
  </bpmn:process>
