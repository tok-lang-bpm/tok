<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="definitions" name="Call activity and bindings" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.3" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="process" name="Call activity and bindings" isExecutable="true">
    <bpmn:startEvent id="s" name="Start">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="f-start" bindingType="versionTag" versionTag="v3" />
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:callActivity id="wysylka" name="Wysyłka" calledElement="wysylka">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="wysylka" bindingType="versionTag" versionTag="v2" propagateAllChildVariables="false" propagateAllParentVariables="false" businessId="=numer" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:callActivity id="dynamiczne" name="Wywołanie dynamiczne">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="=nazwaProcesu" bindingType="deployment" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:businessRuleTask id="ustalenie" name="Ustalenie trybu">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="tryb" resultVariable="tryb" bindingType="deployment" />
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="akcept" name="Akceptacja">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="f-start" bindingType="latest" />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="e" name="Koniec" />
    <bpmn:sequenceFlow id="f-s-wysylka" sourceRef="s" targetRef="wysylka" />
    <bpmn:sequenceFlow id="f-wysylka-dynamiczne" sourceRef="wysylka" targetRef="dynamiczne" />
    <bpmn:sequenceFlow id="f-dynamiczne-ustalenie" sourceRef="dynamiczne" targetRef="ustalenie" />
    <bpmn:sequenceFlow id="f-ustalenie-akcept" sourceRef="ustalenie" targetRef="akcept" />
    <bpmn:sequenceFlow id="f-akcept-e" sourceRef="akcept" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="30" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wysylka_di" bpmnElement="wysylka">
        <dc:Bounds x="116" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dynamiczne_di" bpmnElement="dynamiczne">
        <dc:Bounds x="266" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ustalenie_di" bpmnElement="ustalenie">
        <dc:Bounds x="416" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="akcept_di" bpmnElement="akcept">
        <dc:Bounds x="566" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="716" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f-s-wysylka_di" bpmnElement="f-s-wysylka">
        <di:waypoint x="66" y="70" />
        <di:waypoint x="116" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-wysylka-dynamiczne_di" bpmnElement="f-wysylka-dynamiczne">
        <di:waypoint x="216" y="70" />
        <di:waypoint x="266" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-dynamiczne-ustalenie_di" bpmnElement="f-dynamiczne-ustalenie">
        <di:waypoint x="366" y="70" />
        <di:waypoint x="416" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-ustalenie-akcept_di" bpmnElement="f-ustalenie-akcept">
        <di:waypoint x="516" y="70" />
        <di:waypoint x="566" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-akcept-e_di" bpmnElement="f-akcept-e">
        <di:waypoint x="666" y="70" />
        <di:waypoint x="716" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
