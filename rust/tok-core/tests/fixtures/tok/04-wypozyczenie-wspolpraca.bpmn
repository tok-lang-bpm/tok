        <bpmn:sourceRef>katalog</bpmn:sourceRef>
        <bpmn:targetRef>katalogi-in-3</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sendTask id="wyslanie" name="Wysłanie zamówienia" messageRef="Message_Zamowienie">
      <bpmn:dataOutputAssociation id="wyslanie-doa-4">
