<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" exporter="tok" exporterVersion="0.3" id="definitions" name="Version tags" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="archiwum" name="Archiwum" processRef="kwerenda" />
    <bpmn:participant id="biblioteka" name="Biblioteka" processRef="zamowienie" />
    <bpmn:participant id="czytelnik" name="Czytelnik" />
  </bpmn:collaboration>
  <bpmn:process id="kwerenda" isExecutable="true" name="Archiwum">
