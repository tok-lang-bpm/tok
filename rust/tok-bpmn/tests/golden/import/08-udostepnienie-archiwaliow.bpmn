<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Udostepnienie" targetNamespace="https://codeberg.org/MarekDeja/ipm/diagramy/08">
  <bpmn:message id="Msg_Wniosek" name="Wniosek o udostępnienie" />
  <bpmn:message id="Msg_Powiadomienie" name="Powiadomienie o udostępnieniu" />
  <bpmn:message id="Msg_Odmowa" name="Odmowa udostępnienia" />
  <bpmn:dataStore id="DataStore_Ewidencja" name="Ewidencja udostępnień" />
  <bpmn:collaboration id="Collaboration_Udostepnienie">
    <bpmn:participant id="Participant_Archiwum" name="Archiwum" processRef="Process_Udostepnienie" />
    <bpmn:participant id="Participant_Uzytkownik" name="Użytkownik archiwum" />
    <bpmn:messageFlow id="MF_Wniosek" name="Wniosek" sourceRef="Participant_Uzytkownik" targetRef="Start_Wniosek" messageRef="Msg_Wniosek" />
    <bpmn:messageFlow id="MF_Powiadomienie" name="Powiadomienie" sourceRef="End_Udostepnione" targetRef="Participant_Uzytkownik" messageRef="Msg_Powiadomienie" />
    <bpmn:messageFlow id="MF_Odmowa" name="Odmowa" sourceRef="End_Odmowa" targetRef="Participant_Uzytkownik" messageRef="Msg_Odmowa" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Udostepnienie" name="Udostępnienie materiałów archiwalnych" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System archiwalny">
        <bpmn:flowNodeRef>Task_Tryb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Tryb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rejestracja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Udostepnione</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Czytelnia" name="Pracownik czytelni">
        <bpmn:flowNodeRef>Start_Wniosek</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Weryfikacja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Anonimizacja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Udostepnienie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Przygotowanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Odmowa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Uzasadnienie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Odmowa</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kierownik" name="Kierownik oddziału">
        <bpmn:flowNodeRef>Task_Kontrola</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Kontrola</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dyrektor" name="Dyrektor archiwum">
        <bpmn:flowNodeRef>Task_Zgoda</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Zgoda</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="DataObject_Wniosek" name="Wniosek" />
    <bpmn:dataObjectReference id="DOR_Wniosek_zlozony" name="Wniosek" dataObjectRef="DataObject_Wniosek">
      <bpmn:dataState id="DOR_Wniosek_zlozony_state" name="złożony" />
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DataObject_Kopia" name="Kopia materiałów" />
    <bpmn:dataObjectReference id="DOR_Kopia_anon" name="Kopia materiałów" dataObjectRef="DataObject_Kopia">
      <bpmn:dataState id="DOR_Kopia_anon_state" name="zanonimizowana" />
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="DSR_Ewidencja" name="Ewidencja udostępnień" dataStoreRef="DataStore_Ewidencja" />
    <bpmn:startEvent id="Start_Wniosek" name="Wniosek wpłynął">
      <bpmn:messageEventDefinition id="Start_Wniosek_def" messageRef="Msg_Wniosek" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Weryfikacja" name="Weryfikacja kompletności wniosku">
      <bpmn:property id="Task_Weryfikacja_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Weryfikacja">
        <bpmn:sourceRef>DOR_Wniosek_zlozony</bpmn:sourceRef>
        <bpmn:targetRef>Task_Weryfikacja_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="Task_Tryb" name="Ustalenie trybu udostępnienia" />
    <bpmn:exclusiveGateway id="Gw_Tryb" name="Jaki tryb udostępnienia?" />
    <bpmn:userTask id="Task_Anonimizacja" name="Anonimizacja kopii">
      <bpmn:dataOutputAssociation id="DOA_Anonimizacja">
        <bpmn:targetRef>DOR_Kopia_anon</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Kontrola" name="Kontrola anonimizacji">
      <bpmn:property id="Task_Kontrola_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Kontrola">
        <bpmn:sourceRef>DOR_Kopia_anon</bpmn:sourceRef>
        <bpmn:targetRef>Task_Kontrola_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Kontrola" name="Czy anonimizacja kompletna?" />
    <bpmn:userTask id="Task_Zgoda" name="Decyzja o zgodzie" />
    <bpmn:exclusiveGateway id="Gw_Zgoda" name="Czy zgoda udzielona?" />
    <bpmn:exclusiveGateway id="Gw_Udostepnienie" />
    <bpmn:manualTask id="Task_Przygotowanie" name="Przygotowanie materiałów w czytelni" />
    <bpmn:serviceTask id="Task_Rejestracja" name="Rejestracja udostępnienia">
      <bpmn:dataOutputAssociation id="DOA_Rejestracja">
        <bpmn:targetRef>DSR_Ewidencja</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Udostepnione" name="Materiały udostępnione">
      <bpmn:messageEventDefinition id="End_Udostepnione_def" messageRef="Msg_Powiadomienie" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Odmowa" />
    <bpmn:userTask id="Task_Uzasadnienie" name="Przygotowanie uzasadnienia odmowy" />
    <bpmn:endEvent id="End_Odmowa" name="Odmowa wysłana">
      <bpmn:messageEventDefinition id="End_Odmowa_def" messageRef="Msg_Odmowa" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Wniosek" targetRef="Task_Weryfikacja" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Weryfikacja" targetRef="Task_Tryb" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Tryb" targetRef="Gw_Tryb" />
    <bpmn:sequenceFlow id="F4" name="czytelnia" sourceRef="Gw_Tryb" targetRef="Gw_Udostepnienie" />
    <bpmn:sequenceFlow id="F5" name="anonimizacja" sourceRef="Gw_Tryb" targetRef="Task_Anonimizacja" />
    <bpmn:sequenceFlow id="F6" name="zgoda dyrektora" sourceRef="Gw_Tryb" targetRef="Task_Zgoda" />
    <bpmn:sequenceFlow id="F7" name="odmowa" sourceRef="Gw_Tryb" targetRef="Gw_Odmowa" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Anonimizacja" targetRef="Task_Kontrola" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Kontrola" targetRef="Gw_Kontrola" />
    <bpmn:sequenceFlow id="F10" name="tak" sourceRef="Gw_Kontrola" targetRef="Gw_Udostepnienie" />
    <bpmn:sequenceFlow id="F11" name="nie" sourceRef="Gw_Kontrola" targetRef="Task_Anonimizacja" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Zgoda" targetRef="Gw_Zgoda" />
    <bpmn:sequenceFlow id="F14" name="tak" sourceRef="Gw_Zgoda" targetRef="Gw_Udostepnienie" />
    <bpmn:sequenceFlow id="F15" name="nie" sourceRef="Gw_Zgoda" targetRef="Gw_Odmowa" />
    <bpmn:sequenceFlow id="F16" sourceRef="Gw_Udostepnienie" targetRef="Task_Przygotowanie" />
    <bpmn:sequenceFlow id="F17" sourceRef="Task_Przygotowanie" targetRef="Task_Rejestracja" />
    <bpmn:sequenceFlow id="F18" sourceRef="Task_Rejestracja" targetRef="End_Udostepnione" />
    <bpmn:sequenceFlow id="F19" sourceRef="Gw_Odmowa" targetRef="Task_Uzasadnienie" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_Uzasadnienie" targetRef="End_Odmowa" />
    <bpmn:textAnnotation id="Annotation_Podstawa">
      <bpmn:text>Reguły trybu: tabela decyzyjna „Tryb udostępnienia”. Dane osobowe: RODO, art. 89 (cele archiwalne i badawcze)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Podstawa" sourceRef="Task_Tryb" targetRef="Annotation_Podstawa" />
    <bpmn:textAnnotation id="Annotation_Dwie">
      <bpmn:text>Zasada dwóch par oczu: kopię anonimizuje i sprawdza inna osoba</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Dwie" sourceRef="Task_Kontrola" targetRef="Annotation_Dwie" />
  </bpmn:process>
