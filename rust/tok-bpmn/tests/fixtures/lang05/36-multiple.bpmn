<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" exporter="tok" exporterVersion="0.5" id="definitions" name="Multiple events" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_E_mail" name="E-mail" />
  <bpmn:message id="Message_Formularz" name="Formularz" />
  <bpmn:message id="Message_Potwierdzenie" name="Potwierdzenie" />
  <bpmn:message id="Message_Do_klienta" name="Do klienta" />
  <bpmn:signal id="Signal_Wplata" name="Wpłata" />
  <bpmn:signal id="Signal_Ponaglenie" name="Ponaglenie" />
  <bpmn:signal id="Signal_Zamknieto" name="Zamknięto" />
  <bpmn:escalation id="Escalation_Do_kierownika" name="Do kierownika" />
  <bpmn:process id="process" isExecutable="false" name="Multiple events">
    <bpmn:startEvent id="zgloszenie" name="Zgłoszenie e-mailem lub przez formularz">
      <bpmn:messageEventDefinition id="zgloszenie-def" messageRef="Message_E_mail" />
      <bpmn:messageEventDefinition id="zgloszenie-def-2" messageRef="Message_Formularz" />
    </bpmn:startEvent>
    <bpmn:userTask id="rejestracja" name="Rejestracja zgłoszenia" />
    <bpmn:intermediateCatchEvent id="potwierdzenie" name="Potwierdzenie i płatność" parallelMultiple="true">
      <bpmn:messageEventDefinition id="potwierdzenie-def" messageRef="Message_Potwierdzenie" />
      <bpmn:signalEventDefinition id="potwierdzenie-def-2" signalRef="Signal_Wplata" />
    </bpmn:intermediateCatchEvent>
    <bpmn:boundaryEvent attachedToRef="rejestracja" cancelActivity="false" id="przypomnienie" name="Przypomnienie lub ponaglenie">
      <bpmn:timerEventDefinition id="przypomnienie-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:signalEventDefinition id="przypomnienie-def-2" signalRef="Signal_Ponaglenie" />
    </bpmn:boundaryEvent>
    <bpmn:task id="monit" name="Wysłanie monitu" />
    <bpmn:endEvent id="monit-e" name="Monit wysłany" />
    <bpmn:intermediateThrowEvent id="ogloszenie" name="Ogłoszenie">
      <bpmn:messageEventDefinition id="ogloszenie-def" messageRef="Message_Do_klienta" />
      <bpmn:escalationEventDefinition escalationRef="Escalation_Do_kierownika" id="ogloszenie-def-2" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="koniec" name="Powiadomienia">
      <bpmn:messageEventDefinition id="koniec-def" messageRef="Message_Do_klienta" />
      <bpmn:signalEventDefinition id="koniec-def-2" signalRef="Signal_Zamknieto" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-zgloszenie-rejestracja" sourceRef="zgloszenie" targetRef="rejestracja" />
    <bpmn:sequenceFlow id="f-rejestracja-potwierdzenie" sourceRef="rejestracja" targetRef="potwierdzenie" />
    <bpmn:sequenceFlow id="f-potwierdzenie-ogloszenie" sourceRef="potwierdzenie" targetRef="ogloszenie" />
    <bpmn:sequenceFlow id="f-ogloszenie-koniec" sourceRef="ogloszenie" targetRef="koniec" />
    <bpmn:sequenceFlow id="f-przypomnienie-monit" sourceRef="przypomnienie" targetRef="monit" />
    <bpmn:sequenceFlow id="f-monit-monit-e" sourceRef="monit" targetRef="monit-e" />
  </bpmn:process>
</bpmn:definitions>
