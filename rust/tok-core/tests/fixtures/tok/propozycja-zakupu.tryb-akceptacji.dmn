<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="tryb-akceptacji-definitions" name="Tryb akceptacji" namespace="http://camunda.org/schema/1.0/dmn" exporter="tok" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <decision id="tryb-akceptacji" name="Tryb akceptacji">
    <decisionTable id="tryb-akceptacji-table" hitPolicy="FIRST">
      <input id="tryb-akceptacji-input-1" label="rodzaj">
        <inputExpression id="tryb-akceptacji-input-1-expr" typeRef="string">
          <text>rodzaj</text>
        </inputExpression>
      </input>
      <input id="tryb-akceptacji-input-2" label="cena">
        <inputExpression id="tryb-akceptacji-input-2-expr" typeRef="number">
          <text>cena</text>
        </inputExpression>
      </input>
      <output id="tryb-akceptacji-output-1" label="tryb" name="tryb" typeRef="string" />
      <rule id="tryb-akceptacji-rule-1">
        <description>licencje</description>
        <inputEntry id="tryb-akceptacji-rule-1-in-1">
          <text>"e-book"</text>
        </inputEntry>
        <inputEntry id="tryb-akceptacji-rule-1-in-2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="tryb-akceptacji-rule-1-out-1">
          <text>"kierownik"</text>
        </outputEntry>
      </rule>
      <rule id="tryb-akceptacji-rule-2">
        <description>tania książka</description>
        <inputEntry id="tryb-akceptacji-rule-2-in-1">
          <text>"drukowana"</text>
        </inputEntry>
        <inputEntry id="tryb-akceptacji-rule-2-in-2">
          <text>&lt;= 150</text>
        </inputEntry>
        <outputEntry id="tryb-akceptacji-rule-2-out-1">
          <text>"automatyczny"</text>
        </outputEntry>
      </rule>
      <rule id="tryb-akceptacji-rule-3">
        <description>pozostałe</description>
        <inputEntry id="tryb-akceptacji-rule-3-in-1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="tryb-akceptacji-rule-3-in-2">
          <text>-</text>
        </inputEntry>
        <outputEntry id="tryb-akceptacji-rule-3-out-1">
          <text>"kierownik"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
