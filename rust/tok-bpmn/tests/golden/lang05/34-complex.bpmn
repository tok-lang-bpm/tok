      <bpmndi:BPMNShape id="scalenie_di" bpmnElement="scalenie">
        <dc:Bounds x="866" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="966" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="942" y="93" width="84" height="11" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f-s-rozdzial_di" bpmnElement="f-s-rozdzial">
        <di:waypoint x="66" y="70" />
        <di:waypoint x="116" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-rozdzial-r1_di" bpmnElement="f-rozdzial-r1">
        <di:waypoint x="166" y="70" />
        <di:waypoint x="216" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-rozdzial-r2_di" bpmnElement="f-rozdzial-r2">
        <di:waypoint x="141" y="95" />
        <di:waypoint x="141" y="200" />
        <di:waypoint x="216" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-rozdzial-r3_di" bpmnElement="f-rozdzial-r3">
        <di:waypoint x="141" y="95" />
