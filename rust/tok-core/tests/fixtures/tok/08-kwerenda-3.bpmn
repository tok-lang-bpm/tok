    <bpmn:startEvent id="wplyw" name="Wniosek o kwerendę wpłynął" />
    <bpmn:userTask id="rejestracja" name="Rejestracja wniosku" />
    <bpmn:sendTask id="odmowa" name="Wysłanie odmowy" />
    <bpmn:endEvent id="odrzucony" name="Wniosek odrzucony" />
    <bpmn:sendTask id="odpowiedz" name="Wysłanie odpowiedzi" />
    <bpmn:endEvent id="zakonczona" name="Kwerenda zakończona" />
    <bpmn:userTask id="ocena" name="Ocena wniosku" />
    <bpmn:exclusiveGateway id="mozliwa" name="Czy kwerenda jest możliwa?" />
    <bpmn:userTask id="poszukiwania" name="Poszukiwania w zasobie" />
    <bpmn:userTask id="opracowanie" name="Opracowanie odpowiedzi" />
    <bpmn:sequenceFlow id="f-wplyw-rejestracja" sourceRef="wplyw" targetRef="rejestracja" />
    <bpmn:sequenceFlow id="f-rejestracja-ocena" sourceRef="rejestracja" targetRef="ocena" />
    <bpmn:sequenceFlow id="f-ocena-mozliwa" sourceRef="ocena" targetRef="mozliwa" />
    <bpmn:sequenceFlow id="f-mozliwa-poszukiwania" name="tak" sourceRef="mozliwa" targetRef="poszukiwania" />
    <bpmn:sequenceFlow id="f-mozliwa-odmowa" name="nie" sourceRef="mozliwa" targetRef="odmowa" />
    <bpmn:sequenceFlow id="f-odmowa-odrzucony" sourceRef="odmowa" targetRef="odrzucony" />
    <bpmn:sequenceFlow id="f-poszukiwania-opracowanie" sourceRef="poszukiwania" targetRef="opracowanie" />
    <bpmn:sequenceFlow id="f-opracowanie-odpowiedz" sourceRef="opracowanie" targetRef="odpowiedz" />
    <bpmn:sequenceFlow id="f-odpowiedz-zakonczona" sourceRef="odpowiedz" targetRef="zakonczona" />
  </bpmn:process>
