<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20230324/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:dmndi="https://www.omg.org/spec/DMN/20230324/DMNDI/" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="kanaly-definitions" name="Kanały powiadomień" namespace="http://camunda.org/schema/1.0/dmn" exporter="tok" exporterVersion="0.7" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <itemDefinition id="egzemplarz-t" name="egzemplarz-t" label="Egzemplarz">
    <itemComponent id="egzemplarz-t-1" name="sygnatura">
      <typeRef>string</typeRef>
    </itemComponent>
    <itemComponent id="egzemplarz-t-2" name="stan zachowania">
      <typeRef>string</typeRef>
    </itemComponent>
  </itemDefinition>
  <itemDefinition id="egzemplarze-t" name="egzemplarze-t" label="Lista egzemplarzy" isCollection="true">
    <typeRef>egzemplarz-t</typeRef>
  </itemDefinition>
  <decision id="kanaly" name="kanaly" label="Kanały powiadomień">
    <variable id="kanaly-variable" name="kanaly" />
    <list id="kanaly-list">
      <literalExpression id="kanaly-1-expr">
        <text>"e-mail"</text>
      </literalExpression>
      <literalExpression id="kanaly-2-expr">
        <text>"SMS"</text>
      </literalExpression>
    </list>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_kanaly">
      <dmndi:DMNShape id="DMNShape_kanaly" dmnElementRef="kanaly">
        <dc:Bounds height="80" width="180" x="150" y="80" />
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>
