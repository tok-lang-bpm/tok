<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OdbiorKsiazki" targetNamespace="https://codeberg.org/MarekDeja/ipm/diagramy/06">
  <bpmn:message id="Msg_Paczka" name="Paczka z książką" />
  <bpmn:message id="Msg_Powiadomienie" name="Powiadomienie o książce" />
  <bpmn:message id="Msg_Przypomnienie" name="Przypomnienie o odbiorze" />
  <bpmn:message id="Msg_Zwrot" name="Zwracana książka" />
  <bpmn:error id="Err_Zapis" name="Błąd zapisu rekordu" errorCode="ZAPIS" />
  <bpmn:collaboration id="Collaboration_OdbiorKsiazki">
    <bpmn:participant id="Participant_Biblioteka" name="Biblioteka uczelniana" processRef="Process_OdbiorKsiazki" />
    <bpmn:participant id="Participant_Udostepniajaca" name="Biblioteka udostępniająca" />
    <bpmn:participant id="Participant_Czytelnik" name="Czytelnik" />
    <bpmn:messageFlow id="MF_Paczka" name="Paczka z książką" sourceRef="Participant_Udostepniajaca" targetRef="Start_Dotarla" messageRef="Msg_Paczka" />
    <bpmn:messageFlow id="MF_Powiadomienie" name="Powiadomienie" sourceRef="Task_Powiadomienie" targetRef="Participant_Czytelnik" messageRef="Msg_Powiadomienie" />
    <bpmn:messageFlow id="MF_Przypomnienie" name="Przypomnienie" sourceRef="Task_Przypomnienie" targetRef="Participant_Czytelnik" messageRef="Msg_Przypomnienie" />
    <bpmn:messageFlow id="MF_Zwrot" name="Zwracana książka" sourceRef="Task_Odeslanie" targetRef="Participant_Udostepniajaca" messageRef="Msg_Zwrot" />
  </bpmn:collaboration>
  <bpmn:process id="Process_OdbiorKsiazki" name="Odbiór książki z wypożyczenia międzybibliotecznego" isExecutable="false">
    <bpmn:laneSet id="LaneSet_OdbiorKsiazki">
      <bpmn:lane id="Lane_Bibliotekarz" name="Bibliotekarz wypożyczalni">
        <bpmn:flowNodeRef>Start_Dotarla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RejestracjaReczna</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Zarejestrowano</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Wydanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Przypomnienie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Termin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Wydana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Odeslanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Zwrocona</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System biblioteczny">
        <bpmn:flowNodeRef>Task_Rejestracja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_BladZapisu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Powiadomienie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Przypomnienie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Przypomniano</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Dotarla" name="Książka dotarła">
      <bpmn:messageEventDefinition id="Start_Dotarla_def" messageRef="Msg_Paczka" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Rejestracja" name="Rejestracja egzemplarza w systemie" />
    <bpmn:boundaryEvent id="Boundary_BladZapisu" name="Błąd zapisu rekordu" attachedToRef="Task_Rejestracja">
      <bpmn:errorEventDefinition id="Boundary_BladZapisu_def" errorRef="Err_Zapis" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_RejestracjaReczna" name="Rejestracja ręczna egzemplarza" />
    <bpmn:exclusiveGateway id="Gw_Zarejestrowano" />
    <bpmn:sendTask id="Task_Powiadomienie" name="Powiadomienie czytelnika" messageRef="Msg_Powiadomienie" />
    <bpmn:userTask id="Task_Wydanie" name="Wydanie książki czytelnikowi" />
    <bpmn:boundaryEvent id="Boundary_Przypomnienie" name="Minęły 4 dni" attachedToRef="Task_Wydanie" cancelActivity="false">
      <bpmn:timerEventDefinition id="Boundary_Przypomnienie_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P4D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Termin" name="Minęło 7 dni" attachedToRef="Task_Wydanie">
      <bpmn:timerEventDefinition id="Boundary_Termin_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Task_Przypomnienie" name="Wysłanie przypomnienia" messageRef="Msg_Przypomnienie" />
    <bpmn:endEvent id="End_Przypomniano" name="Przypomnienie wysłane" />
    <bpmn:endEvent id="End_Wydana" name="Książka wydana" />
    <bpmn:manualTask id="Task_Odeslanie" name="Odesłanie książki do biblioteki udostępniającej" />
    <bpmn:endEvent id="End_Zwrocona" name="Książka zwrócona bez wypożyczenia" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Dotarla" targetRef="Task_Rejestracja" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Rejestracja" targetRef="Gw_Zarejestrowano" />
    <bpmn:sequenceFlow id="F3" sourceRef="Boundary_BladZapisu" targetRef="Task_RejestracjaReczna" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_RejestracjaReczna" targetRef="Gw_Zarejestrowano" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_Zarejestrowano" targetRef="Task_Powiadomienie" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Powiadomienie" targetRef="Task_Wydanie" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Wydanie" targetRef="End_Wydana" />
    <bpmn:sequenceFlow id="F8" sourceRef="Boundary_Przypomnienie" targetRef="Task_Przypomnienie" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Przypomnienie" targetRef="End_Przypomniano" />
    <bpmn:sequenceFlow id="F10" sourceRef="Boundary_Termin" targetRef="Task_Odeslanie" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Odeslanie" targetRef="End_Zwrocona" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_OdbiorKsiazki">
      <bpmndi:BPMNShape id="Participant_Biblioteka_di" bpmnElement="Participant_Biblioteka" isHorizontal="true">
