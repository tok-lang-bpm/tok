<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Magazyn" targetNamespace="https://codeberg.org/MarekDeja/ipm/diagramy/03">
  <bpmn:collaboration id="Collaboration_Magazyn">
    <bpmn:participant id="Participant_Biblioteka" name="Biblioteka uczelniana" processRef="Process_Magazyn" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Magazyn" name="Zamówienie książki z magazynu" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Czytelnik" name="Czytelnik">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zlozenie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System biblioteczny">
        <bpmn:flowNodeRef>Task_Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Dostepny</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Odmowa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Odrzucone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Rozwidlenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Powiadomienie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Zlaczenie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Magazynier" name="Magazynier">
        <bpmn:flowNodeRef>Task_Pobranie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bibliotekarz" name="Bibliotekarz">
        <bpmn:flowNodeRef>Task_Wydanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Wypozyczona</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Potrzeba książki z magazynu" />
    <bpmn:userTask id="Task_Zlozenie" name="Złożenie zamówienia" />
    <bpmn:serviceTask id="Task_Status" name="Sprawdzenie statusu egzemplarza" />
    <bpmn:exclusiveGateway id="Gw_Dostepny" name="Czy egzemplarz dostępny?" />
    <bpmn:serviceTask id="Task_Odmowa" name="Powiadomienie o niedostępności" />
    <bpmn:endEvent id="End_Odrzucone" name="Zamówienie odrzucone" />
    <bpmn:parallelGateway id="Gw_Rozwidlenie" />
    <bpmn:manualTask id="Task_Pobranie" name="Pobranie książki z magazynu" />
    <bpmn:serviceTask id="Task_Powiadomienie" name="Powiadomienie o terminie odbioru" />
    <bpmn:parallelGateway id="Gw_Zlaczenie" />
    <bpmn:userTask id="Task_Wydanie" name="Wydanie książki" />
    <bpmn:endEvent id="End_Wypozyczona" name="Książka wypożyczona" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Zlozenie" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Zlozenie" targetRef="Task_Status" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Status" targetRef="Gw_Dostepny" />
    <bpmn:sequenceFlow id="F4" name="nie" sourceRef="Gw_Dostepny" targetRef="Task_Odmowa" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Odmowa" targetRef="End_Odrzucone" />
    <bpmn:sequenceFlow id="F6" name="tak" sourceRef="Gw_Dostepny" targetRef="Gw_Rozwidlenie" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_Rozwidlenie" targetRef="Task_Pobranie" />
    <bpmn:sequenceFlow id="F8" sourceRef="Gw_Rozwidlenie" targetRef="Task_Powiadomienie" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Pobranie" targetRef="Gw_Zlaczenie" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Powiadomienie" targetRef="Gw_Zlaczenie" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Zlaczenie" targetRef="Task_Wydanie" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Wydanie" targetRef="End_Wypozyczona" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Magazyn">
      <bpmndi:BPMNShape id="Participant_Biblioteka_di" bpmnElement="Participant_Biblioteka" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1200" height="690" />
