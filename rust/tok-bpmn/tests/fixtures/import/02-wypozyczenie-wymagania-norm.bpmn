      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Wyslane_di" bpmnElement="End_Wyslane">
        <dc:Bounds x="996" y="712" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_Poufnosc_di" bpmnElement="Ann_Poufnosc">
        <dc:Bounds x="176" y="160" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann_Zapis_di" bpmnElement="Ann_Zapis">
        <dc:Bounds x="356" y="430" width="130" height="70" />
