    <bpmn:messageFlow id="m-wyslanie-udostepniajaca" name="Zamówienie" sourceRef="wyslanie" targetRef="udostepniajaca" messageRef="Message_Zamowienie" />
    <bpmn:messageFlow id="m-udostepniajaca-przesylka" name="Przesyłka z egzemplarzem" sourceRef="udostepniajaca" targetRef="przesylka" messageRef="Message_Przesylka_z_egzemplarzem" />
  </bpmn:collaboration>
  <bpmn:process id="biblioteka-process" name="Wypożyczenie międzybiblioteczne: współpraca" isExecutable="false">
    <bpmn:laneSet id="biblioteka-lanes">
      <bpmn:lane id="czytelnik" name="Czytelnik">
