<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions" name="Wypożyczenie międzybiblioteczne: współpraca" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.1">
  <bpmn:message id="Message_Zamowienie" name="Zamówienie" />
  <bpmn:message id="Message_Przesylka_z_egzemplarzem" name="Przesyłka z egzemplarzem" />
  <bpmn:dataStore id="katalog-store" name="Katalog NUKAT" />
  <bpmn:dataStore id="rejestr-store" name="Rejestr wypożyczeń" />
  <bpmn:collaboration id="collaboration">
