<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PismoBledy" targetNamespace="https://codeberg.org/MarekDeja/ipm/diagramy/03">
  <bpmn:collaboration id="Collaboration_PismoBledy">
    <bpmn:participant id="Participant_Kancelaria" name="Kancelaria uczelni" processRef="Process_PismoBledy" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PismoBledy" name="Rejestracja pisma (model z błędami)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Kancelaria" name="Pracownik kancelarii">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rejestracja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Rozwidlenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Skan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Numer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Zlaczenie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kierownik" name="Kierownik jednostki">
        <bpmn:flowNodeRef>Task_Dekretacja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Odpowiedz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Odpowiedz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Wyslana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Archiwizacja</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Pismo wpłynęło" />
    <bpmn:userTask id="Task_Rejestracja" name="Rejestracja pisma w EZD" />
    <bpmn:parallelGateway id="Gw_Rozwidlenie" />
    <bpmn:userTask id="Task_Skan" name="Skanowanie pisma" />
    <bpmn:userTask id="Task_Numer" name="Powiadomienie adresata pisma" />
    <bpmn:exclusiveGateway id="Gw_Zlaczenie" />
    <bpmn:userTask id="Task_Dekretacja" name="Dekretacja pisma" />
    <bpmn:exclusiveGateway id="Gw_Odpowiedz" name="Czy pismo wymaga odpowiedzi?" />
    <bpmn:userTask id="Task_Odpowiedz" name="Przygotowanie odpowiedzi" />
    <bpmn:endEvent id="End_Wyslana" name="Odpowiedź wysłana" />
    <bpmn:userTask id="Task_Archiwizacja" name="Przekazanie pisma do akt" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_Rejestracja" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Rejestracja" targetRef="Gw_Rozwidlenie" />
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_Rozwidlenie" targetRef="Task_Skan" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Rozwidlenie" targetRef="Task_Numer" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Skan" targetRef="Gw_Zlaczenie" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Numer" targetRef="Gw_Zlaczenie" />
    <bpmn:sequenceFlow id="F7" sourceRef="Gw_Zlaczenie" targetRef="Task_Dekretacja" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Dekretacja" targetRef="Gw_Odpowiedz" />
    <bpmn:sequenceFlow id="F9" name="tak" sourceRef="Gw_Odpowiedz" targetRef="Task_Odpowiedz" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Odpowiedz" targetRef="End_Wyslana" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_Odpowiedz" targetRef="Task_Archiwizacja" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
