<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="definitions" name="Kompensacja" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.3" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="kompensacja" name="Kompensacja" isExecutable="true">
    <bpmn:startEvent id="s" name="Start" />
    <bpmn:serviceTask id="rezerwacja" name="Rezerwacja środków">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rezerwacja" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="rezerwacja-compensate" attachedToRef="rezerwacja">
      <bpmn:compensateEventDefinition id="rezerwacja-compensate-def" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="zwolnienie" name="Zwolnienie rezerwacji" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="zwolnienie" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="cofniecie" name="Cofnięcie rezerwacji">
      <bpmn:compensateEventDefinition id="cofniecie-def" activityRef="rezerwacja" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="e" name="Koniec" />
    <bpmn:sequenceFlow id="f-s-rezerwacja" sourceRef="s" targetRef="rezerwacja" />
    <bpmn:sequenceFlow id="f-rezerwacja-cofniecie" sourceRef="rezerwacja" targetRef="cofniecie" />
    <bpmn:sequenceFlow id="f-cofniecie-e" sourceRef="cofniecie" targetRef="e" />
    <bpmn:association id="rezerwacja-compensate-assoc" associationDirection="One" sourceRef="rezerwacja-compensate" targetRef="zwolnienie" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="kompensacja">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="62" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rezerwacja_di" bpmnElement="rezerwacja">
        <dc:Bounds x="180" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="zwolnienie_di" bpmnElement="zwolnienie">
        <dc:Bounds x="30" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cofniecie_di" bpmnElement="cofniecie">
        <dc:Bounds x="330" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="416" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rezerwacja-compensate_di" bpmnElement="rezerwacja-compensate">
        <dc:Bounds x="232" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f-s-rezerwacja_di" bpmnElement="f-s-rezerwacja">
        <di:waypoint x="98" y="70" />
        <di:waypoint x="180" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-rezerwacja-cofniecie_di" bpmnElement="f-rezerwacja-cofniecie">
        <di:waypoint x="280" y="70" />
        <di:waypoint x="330" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-cofniecie-e_di" bpmnElement="f-cofniecie-e">
        <di:waypoint x="366" y="70" />
        <di:waypoint x="416" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="rezerwacja-compensate-assoc_di" bpmnElement="rezerwacja-compensate-assoc">
        <di:waypoint x="232" y="120" />
        <di:waypoint x="130" y="174" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
