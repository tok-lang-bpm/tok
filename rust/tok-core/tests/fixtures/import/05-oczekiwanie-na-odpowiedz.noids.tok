tok 0.1 "Realizacja zamówienia międzybibliotecznego" id=Definitions_Oczekiwanie namespace=https://codeberg.org/MarekDeja/ipm/diagramy/05 collaboration=Collaboration_Oczekiwanie

pool Participant_Biblioteka "Biblioteka uczelniana" process=Process_Oczekiwanie
  lane Lane_Bibliotekarz "Bibliotekarz wypożyczalni międzybibliotecznej"
    start Start_Przyjete "Zamówienie przyjęte do realizacji"
    xor Gw_Wyslij
    send Task_Wyslanie "Wysłanie zamówienia" message="Zamówienie"
    xor Gw_Czekaj
    eventgw Gw_Odpowiedz "Co nastąpi pierwsze?"
    catch Catch_Egzemplarz "Egzemplarz otrzymany" message="Przesyłka z egzemplarzem"
    catch Catch_Odmowa "Odmowa otrzymana" message="Odmowa"
    catch Catch_14dni "Minęło 14 dni" timer=P14D
    user Task_Przyjecie "Przyjęcie egzemplarza"
    end End_Przyjety "Egzemplarz przyjęty"
    xor Gw_Ponaglono "Czy wysłano już ponaglenie?"
    send Task_Ponaglenie "Wysłanie ponaglenia" message="Ponaglenie"
    xor Gw_Brak
    xor Gw_Inna "Czy inna biblioteka ma egzemplarz?"
    user Task_Wybor "Wybór innej biblioteki"
  lane Lane_System "System biblioteczny"
    service Task_Informacja "Powiadomienie czytelnika o niepowodzeniu"
    end End_Niezrealizowane "Zamówienie niezrealizowane"

pool Participant_Udostepniajaca "Biblioteka udostępniająca"

flow Start_Przyjete -> Gw_Wyslij -> Task_Wyslanie -> Gw_Czekaj -> Gw_Odpowiedz
flow Gw_Odpowiedz -> Catch_Egzemplarz
flow Gw_Odpowiedz -> Catch_Odmowa
flow Gw_Odpowiedz -> Catch_14dni
flow Catch_Egzemplarz -> Task_Przyjecie -> End_Przyjety
flow Catch_14dni -> Gw_Ponaglono
flow Gw_Ponaglono -> Task_Ponaglenie "nie"
flow Task_Ponaglenie -> Gw_Czekaj
flow Gw_Ponaglono -> Gw_Brak "tak"
flow Catch_Odmowa -> Gw_Brak -> Gw_Inna
flow Gw_Inna -> Task_Wybor "tak"
flow Task_Wybor -> Gw_Wyslij
flow Gw_Inna -> Task_Informacja "nie"
flow Task_Informacja -> End_Niezrealizowane

message Task_Wyslanie -> Participant_Udostepniajaca "Zamówienie"
message Task_Ponaglenie -> Participant_Udostepniajaca "Ponaglenie"
message Participant_Udostepniajaca -> Catch_Egzemplarz "Przesyłka" message="Przesyłka z egzemplarzem"
message Participant_Udostepniajaca -> Catch_Odmowa "Odmowa"
