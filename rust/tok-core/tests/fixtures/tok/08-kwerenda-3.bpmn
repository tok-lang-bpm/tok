  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="archiwum" name="Archiwum Państwowe" processRef="archiwum-process" />
  </bpmn:collaboration>
  <bpmn:process id="archiwum-process" name="Kwerenda archiwalna: trzech archiwistów" isExecutable="false">
    <bpmn:laneSet id="archiwum-lanes">
      <bpmn:lane id="kancelaria" name="Kancelaria">
        <bpmn:flowNodeRef>wplyw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejestracja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>odmowa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>odrzucony</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>odpowiedz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>zakonczona</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="archiwista" name="Archiwista">
        <bpmn:flowNodeRef>ocena</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mozliwa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>poszukiwania</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>opracowanie</bpmn:flowNodeRef>
      </bpmn:lane>
