<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions" name="Kwerenda archiwalna z podprocesem" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.1">
  <bpmn:message id="Message_Wniosek_o_kwerende" name="Wniosek o kwerendę" />
  <bpmn:message id="Message_Odpowiedz_na_kwerende" name="Odpowiedź na kwerendę" />
  <bpmn:message id="Message_Wycofanie_wniosku" name="Wycofanie wniosku" />
  <bpmn:escalation id="Escalation_Trudna_kwerenda" name="Trudna kwerenda" />
  <bpmn:collaboration id="collaboration">
    <bpmn:participant id="archiwum" name="Archiwum Państwowe" processRef="archiwum-process" />
    <bpmn:participant id="wnioskodawca" name="Wnioskodawca" />
    <bpmn:messageFlow id="m-wnioskodawca-wniosek" name="Wniosek o kwerendę" sourceRef="wnioskodawca" targetRef="wniosek" messageRef="Message_Wniosek_o_kwerende" />
    <bpmn:messageFlow id="m-wyslana-wnioskodawca" name="Odpowiedź na kwerendę" sourceRef="wyslana" targetRef="wnioskodawca" messageRef="Message_Odpowiedz_na_kwerende" />
    <bpmn:messageFlow id="m-wnioskodawca-w-start" name="Wycofanie wniosku" sourceRef="wnioskodawca" targetRef="w-start" messageRef="Message_Wycofanie_wniosku" />
  </bpmn:collaboration>
  <bpmn:process id="archiwum-process" name="Kwerenda archiwalna z podprocesem" isExecutable="false">
    <bpmn:laneSet id="archiwum-lanes">
      <bpmn:lane id="kancelaria" name="Kancelaria">
        <bpmn:flowNodeRef>wniosek</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rejestracja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>zakres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bezprzedmiotowy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wycofanie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="archiwista" name="Archiwista">
        <bpmn:flowNodeRef>poszukiwania</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>eskalacja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>odpowiedz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>wyslana</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="kierownik" name="Kierownik oddziału">
        <bpmn:flowNodeRef>decyzja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>rozstrzygnieto</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="wniosek" name="Wniosek o kwerendę wpłynął">
      <bpmn:messageEventDefinition id="wniosek-def" messageRef="Message_Wniosek_o_kwerende" />
    </bpmn:startEvent>
    <bpmn:userTask id="rejestracja" name="Rejestracja wniosku" />
    <bpmn:exclusiveGateway id="zakres" name="Czy wniosek dotyczy zasobu archiwum?" />
    <bpmn:endEvent id="bezprzedmiotowy" name="Wniosek bezprzedmiotowy">
      <bpmn:terminateEventDefinition id="bezprzedmiotowy-def" />
    </bpmn:endEvent>
    <bpmn:subProcess id="wycofanie" name="Wycofanie wniosku" triggeredByEvent="true">
      <bpmn:startEvent id="w-start" name="Wniosek wycofany">
        <bpmn:messageEventDefinition id="w-start-def" messageRef="Message_Wycofanie_wniosku" />
      </bpmn:startEvent>
      <bpmn:userTask id="zamkniecie" name="Zamknięcie sprawy" />
      <bpmn:endEvent id="w-koniec" name="Sprawa zamknięta" />
      <bpmn:sequenceFlow id="f-w-start-zamkniecie" sourceRef="w-start" targetRef="zamkniecie" />
      <bpmn:sequenceFlow id="f-zamkniecie-w-koniec" sourceRef="zamkniecie" targetRef="w-koniec" />
    </bpmn:subProcess>
    <bpmn:subProcess id="poszukiwania" name="Poszukiwania w zasobie">
      <bpmn:startEvent id="p-start" />
      <bpmn:userTask id="inwentarze" name="Przegląd inwentarzy" />
      <bpmn:exclusiveGateway id="znaleziono" name="Czy znaleziono akta?" />
      <bpmn:userTask id="akta" name="Analiza akt" />
      <bpmn:intermediateThrowEvent id="trudnosc" name="Kwerenda wymaga decyzji kierownika">
        <bpmn:escalationEventDefinition id="trudnosc-def" escalationRef="Escalation_Trudna_kwerenda" />
      </bpmn:intermediateThrowEvent>
      <bpmn:endEvent id="p-koniec" name="Poszukiwania zakończone" />
      <bpmn:sequenceFlow id="f-p-start-inwentarze" sourceRef="p-start" targetRef="inwentarze" />
      <bpmn:sequenceFlow id="f-inwentarze-znaleziono" sourceRef="inwentarze" targetRef="znaleziono" />
      <bpmn:sequenceFlow id="f-znaleziono-akta" name="tak" sourceRef="znaleziono" targetRef="akta" />
      <bpmn:sequenceFlow id="f-znaleziono-trudnosc" name="nie" sourceRef="znaleziono" targetRef="trudnosc" />
      <bpmn:sequenceFlow id="f-trudnosc-akta" sourceRef="trudnosc" targetRef="akta" />
      <bpmn:sequenceFlow id="f-akta-p-koniec" sourceRef="akta" targetRef="p-koniec" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="eskalacja" name="Trudna kwerenda" attachedToRef="poszukiwania" cancelActivity="false">
      <bpmn:escalationEventDefinition id="eskalacja-def" escalationRef="Escalation_Trudna_kwerenda" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="odpowiedz" name="Przygotowanie odpowiedzi" />
    <bpmn:endEvent id="wyslana" name="Odpowiedź wysłana">
      <bpmn:messageEventDefinition id="wyslana-def" messageRef="Message_Odpowiedz_na_kwerende" />
    </bpmn:endEvent>
    <bpmn:userTask id="decyzja" name="Decyzja o dalszych poszukiwaniach" />
    <bpmn:endEvent id="rozstrzygnieto" name="Sprawa rozstrzygnięta" />
    <bpmn:sequenceFlow id="f-wniosek-rejestracja" sourceRef="wniosek" targetRef="rejestracja" />
    <bpmn:sequenceFlow id="f-rejestracja-zakres" sourceRef="rejestracja" targetRef="zakres" />
    <bpmn:sequenceFlow id="f-zakres-poszukiwania" name="tak" sourceRef="zakres" targetRef="poszukiwania" />
    <bpmn:sequenceFlow id="f-zakres-bezprzedmiotowy" name="nie" sourceRef="zakres" targetRef="bezprzedmiotowy" />
    <bpmn:sequenceFlow id="f-poszukiwania-odpowiedz" sourceRef="poszukiwania" targetRef="odpowiedz" />
    <bpmn:sequenceFlow id="f-odpowiedz-wyslana" sourceRef="odpowiedz" targetRef="wyslana" />
    <bpmn:sequenceFlow id="f-eskalacja-decyzja" sourceRef="eskalacja" targetRef="decyzja" />
    <bpmn:sequenceFlow id="f-decyzja-rozstrzygnieto" sourceRef="decyzja" targetRef="rozstrzygnieto" />
  </bpmn:process>
