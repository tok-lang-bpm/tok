      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="zakonczona_di" bpmnElement="zakonczona">
        <dc:Bounds x="1266" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f-wplynela-ocena_di" bpmnElement="f-wplynela-ocena">
        <di:waypoint x="66" y="70" />
        <di:waypoint x="116" y="70" />
      </bpmndi:BPMNEdge>
