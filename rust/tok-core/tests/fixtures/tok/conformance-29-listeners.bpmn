<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="definitions" name="Listeners" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.3" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="process" name="Listeners" isExecutable="true">
    <bpmn:startEvent id="s" name="Start">
      <bpmn:extensionElements>
        <zeebe:executionListeners>
          <zeebe:executionListener eventType="end" type="po-starcie" />
        </zeebe:executionListeners>
      </bpmn:extensionElements>
    </bpmn:startEvent>
    <bpmn:scriptTask id="wyliczenie" name="Wyliczenie">
      <bpmn:extensionElements>
        <zeebe:script expression="=1 + 1" resultVariable="wynik" />
        <zeebe:executionListeners>
          <zeebe:executionListener eventType="start" type="przed" />
          <zeebe:executionListener eventType="end" type="po" retries="5" />
        </zeebe:executionListeners>
      </bpmn:extensionElements>
    </bpmn:scriptTask>
    <bpmn:userTask id="decyzja" name="Decyzja">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:executionListeners>
          <zeebe:executionListener eventType="start" type="wejscie" />
        </zeebe:executionListeners>
        <zeebe:taskListeners>
          <zeebe:taskListener eventType="creating" type="utworzenie" retries="2" />
          <zeebe:taskListener eventType="completing" type="zakonczenie" />
        </zeebe:taskListeners>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:endEvent id="e" name="Koniec" />
    <bpmn:sequenceFlow id="f-s-wyliczenie" sourceRef="s" targetRef="wyliczenie" />
    <bpmn:sequenceFlow id="f-wyliczenie-decyzja" sourceRef="wyliczenie" targetRef="decyzja" />
    <bpmn:sequenceFlow id="f-decyzja-e" sourceRef="decyzja" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="30" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wyliczenie_di" bpmnElement="wyliczenie">
        <dc:Bounds x="116" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decyzja_di" bpmnElement="decyzja">
        <dc:Bounds x="266" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="416" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f-s-wyliczenie_di" bpmnElement="f-s-wyliczenie">
        <di:waypoint x="66" y="70" />
        <di:waypoint x="116" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-wyliczenie-decyzja_di" bpmnElement="f-wyliczenie-decyzja">
        <di:waypoint x="216" y="70" />
        <di:waypoint x="266" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-decyzja-e_di" bpmnElement="f-decyzja-e">
        <di:waypoint x="366" y="70" />
        <di:waypoint x="416" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
