    <bpmn:dataStoreReference id="katalog" name="Katalog NUKAT" dataStoreRef="katalog-store" />
    <bpmn:dataStoreReference id="rejestr" name="Rejestr wypożyczeń" dataStoreRef="rejestr-store" />
    <bpmn:textAnnotation id="podstawa">
