<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="definitions" name="Conditional events" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.3" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="process" name="Conditional events" isExecutable="true">
    <bpmn:startEvent id="s" name="Start">
      <bpmn:conditionalEventDefinition id="s-def">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">=gotowe = true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="czekanie" name="Kompletne dane">
      <bpmn:extensionElements>
        <zeebe:conditionalFilter variableEvents="create, update" />
      </bpmn:extensionElements>
      <bpmn:conditionalEventDefinition id="czekanie-def">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">=kompletne = true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="praca" name="Praca">
      <bpmn:extensionElements>
        <zeebe:userTask />
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="zmiana" name="Zmiana priorytetu" attachedToRef="praca" cancelActivity="false">
      <bpmn:extensionElements>
        <zeebe:conditionalFilter variableEvents="update" />
      </bpmn:extensionElements>
      <bpmn:conditionalEventDefinition id="zmiana-def">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">=priorytet &gt; 80</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="alarm" name="Alarm" triggeredByEvent="true">
      <bpmn:startEvent id="s2" name="Alarm">
        <bpmn:extensionElements>
          <zeebe:conditionalFilter variableEvents="create" />
        </bpmn:extensionElements>
        <bpmn:conditionalEventDefinition id="s2-def">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">=alarm = true</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:startEvent>
      <bpmn:endEvent id="e2" />
      <bpmn:sequenceFlow id="f-s2-e2" sourceRef="s2" targetRef="e2" />
    </bpmn:subProcess>
    <bpmn:endEvent id="e" name="Koniec" />
    <bpmn:endEvent id="e3" name="Priorytet" />
    <bpmn:sequenceFlow id="f-s-czekanie" sourceRef="s" targetRef="czekanie" />
    <bpmn:sequenceFlow id="f-czekanie-praca" sourceRef="czekanie" targetRef="praca" />
    <bpmn:sequenceFlow id="f-praca-e" sourceRef="praca" targetRef="e" />
    <bpmn:sequenceFlow id="f-zmiana-e3" sourceRef="zmiana" targetRef="e3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="30" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="czekanie_di" bpmnElement="czekanie">
        <dc:Bounds x="116" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="praca_di" bpmnElement="praca">
        <dc:Bounds x="202" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="alarm_di" bpmnElement="alarm" isExpanded="true">
        <dc:Bounds x="30" y="246" width="190" height="110" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_di" bpmnElement="s2">
        <dc:Bounds x="60" y="286" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2">
        <dc:Bounds x="146" y="286" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="352" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e3_di" bpmnElement="e3">
        <dc:Bounds x="352" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="zmiana_di" bpmnElement="zmiana">
        <dc:Bounds x="254" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f-s2-e2_di" bpmnElement="f-s2-e2">
        <di:waypoint x="96" y="304" />
        <di:waypoint x="146" y="304" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-s-czekanie_di" bpmnElement="f-s-czekanie">
        <di:waypoint x="66" y="70" />
        <di:waypoint x="116" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-czekanie-praca_di" bpmnElement="f-czekanie-praca">
        <di:waypoint x="152" y="70" />
        <di:waypoint x="202" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-praca-e_di" bpmnElement="f-praca-e">
        <di:waypoint x="302" y="70" />
        <di:waypoint x="352" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f-zmiana-e3_di" bpmnElement="f-zmiana-e3">
        <di:waypoint x="272" y="128" />
        <di:waypoint x="272" y="178" />
        <di:waypoint x="352" y="178" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
