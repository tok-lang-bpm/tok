<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PismoJakJest" targetNamespace="https://codeberg.org/MarekDeja/ipm/diagramy/07">
  <bpmn:dataStore id="DataStore_Dziennik" name="Dziennik podawczy (papierowy)" />
  <bpmn:dataStore id="DataStore_EZD" name="System EZD" />
  <bpmn:dataStore id="DataStore_RejestrSekretariatu" name="Rejestr sekretariatu (arkusz)" />
  <bpmn:collaboration id="Collaboration_PismoJakJest">
    <bpmn:participant id="Participant_Uczelnia" name="Uczelnia" processRef="Process_PismoJakJest" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PismoJakJest" name="Rejestracja pisma przychodzącego — jak jest" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PismoJakJest">
      <bpmn:lane id="Lane_Kancelaria" name="Kancelaria ogólna">
        <bpmn:flowNodeRef>Start_Wplynelo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dziennik</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Skanowanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EZD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Scalenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Przekazanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ustalenie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sekretariat" name="Sekretariat jednostki">
        <bpmn:flowNodeRef>Task_RejestrSekretariatu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Przedlozenie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kierownik" name="Kierownik jednostki">
        <bpmn:flowNodeRef>Task_Dekretacja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Wlasciwa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zalatwienie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Przekazane</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Wplynelo" name="Pismo wpłynęło" />
    <bpmn:manualTask id="Task_Dziennik" name="Wpis do dziennika podawczego">
      <bpmn:dataOutputAssociation id="DOA_Dziennik">
        <bpmn:targetRef>DataStoreRef_Dziennik</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_Skanowanie" name="Skanowanie pisma" />
    <bpmn:userTask id="Task_EZD" name="Rejestracja pisma w EZD">
      <bpmn:dataOutputAssociation id="DOA_EZD">
        <bpmn:targetRef>DataStoreRef_EZD</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Scalenie" />
    <bpmn:manualTask id="Task_Przekazanie" name="Przekazanie oryginału do sekretariatu" />
    <bpmn:userTask id="Task_RejestrSekretariatu" name="Wpis do rejestru sekretariatu">
      <bpmn:dataOutputAssociation id="DOA_RejestrSekretariatu">
        <bpmn:targetRef>DataStoreRef_RejestrSekretariatu</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_Przedlozenie" name="Przedłożenie pisma kierownikowi" />
    <bpmn:manualTask id="Task_Dekretacja" name="Dekretacja pisma na papierze" />
    <bpmn:exclusiveGateway id="Gw_Wlasciwa" name="Czy pismo trafiło do właściwej jednostki?" />
    <bpmn:manualTask id="Task_Ustalenie" name="Ustalenie właściwej jednostki" />
    <bpmn:manualTask id="Task_Zalatwienie" name="Przekazanie pisma do załatwienia" />
    <bpmn:endEvent id="End_Przekazane" name="Pismo przekazane do załatwienia" />
    <bpmn:dataStoreReference id="DataStoreRef_Dziennik" name="Dziennik podawczy (papierowy)" dataStoreRef="DataStore_Dziennik" />
    <bpmn:dataStoreReference id="DataStoreRef_EZD" name="System EZD" dataStoreRef="DataStore_EZD" />
    <bpmn:dataStoreReference id="DataStoreRef_RejestrSekretariatu" name="Rejestr sekretariatu (arkusz)" dataStoreRef="DataStore_RejestrSekretariatu" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Wplynelo" targetRef="Task_Dziennik" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Dziennik" targetRef="Task_Skanowanie" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Skanowanie" targetRef="Task_EZD" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_EZD" targetRef="Gw_Scalenie" />
    <bpmn:sequenceFlow id="F5" sourceRef="Gw_Scalenie" targetRef="Task_Przekazanie" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Przekazanie" targetRef="Task_RejestrSekretariatu" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_RejestrSekretariatu" targetRef="Task_Przedlozenie" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Przedlozenie" targetRef="Task_Dekretacja" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Dekretacja" targetRef="Gw_Wlasciwa" />
    <bpmn:sequenceFlow id="F10" name="tak" sourceRef="Gw_Wlasciwa" targetRef="Task_Zalatwienie" />
    <bpmn:sequenceFlow id="F11" name="nie" sourceRef="Gw_Wlasciwa" targetRef="Task_Ustalenie" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_Ustalenie" targetRef="Gw_Scalenie" />
    <bpmn:sequenceFlow id="F13" sourceRef="Task_Zalatwienie" targetRef="End_Przekazane" />
  </bpmn:process>
