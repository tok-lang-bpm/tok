      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:receiveTask id="przesylka" name="Odbiór przesyłki" messageRef="Message_Przesylka_z_egzemplarzem" />
    <bpmn:serviceTask id="rejestracja" name="Rejestracja wypożyczenia">
      <bpmn:dataOutputAssociation id="rejestracja-doa-5">
        <bpmn:targetRef>rejestr</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
