      <bpmn:property id="katalogi-in-3" name="__targetRef_placeholder" />
      <bpmn:property id="katalogi-in-2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="katalogi-dia-2">
        <bpmn:sourceRef>zam-zlozone</bpmn:sourceRef>
        <bpmn:targetRef>katalogi-in-2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
