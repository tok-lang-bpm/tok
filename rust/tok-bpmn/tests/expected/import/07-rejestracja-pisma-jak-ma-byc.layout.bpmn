<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PismoJakMaByc" targetNamespace="https://codeberg.org/MarekDeja/ipm/diagramy/07">
  <bpmn:dataStore id="DataStore_EZD" name="System EZD" />
  <bpmn:dataStore id="DataStore_Sklad" name="Skład chronologiczny" />
  <bpmn:collaboration id="Collaboration_PismoJakMaByc">
    <bpmn:participant id="Participant_Uczelnia" name="Uczelnia" processRef="Process_PismoJakMaByc" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PismoJakMaByc" name="Rejestracja pisma przychodzącego — jak ma być" isExecutable="false">
    <bpmn:laneSet id="LaneSet_PismoJakMaByc">
      <bpmn:lane id="Lane_Kancelaria" name="Kancelaria ogólna">
        <bpmn:flowNodeRef>Start_Wplynelo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rejestracja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Rozwidlenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sklad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Korekta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Zlaczenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Przekazane</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System EZD">
        <bpmn:flowNodeRef>Task_Wstepna</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kierownik" name="Kierownik jednostki">
        <bpmn:flowNodeRef>Gw_Scalenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Dekretacja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Wlasciwa</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Wplynelo" name="Pismo wpłynęło" />
    <bpmn:userTask id="Task_Rejestracja" name="Skanowanie i rejestracja pisma w EZD">
      <bpmn:dataOutputAssociation id="DOA_EZD">
        <bpmn:targetRef>DataStoreRef_EZD</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gw_Rozwidlenie" />
    <bpmn:manualTask id="Task_Sklad" name="Odłożenie oryginału do składu chronologicznego">
      <bpmn:dataOutputAssociation id="DOA_Sklad">
        <bpmn:targetRef>DataStoreRef_Sklad</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:businessRuleTask id="Task_Wstepna" name="Wstępny przydział według wykazu jednostek" />
    <bpmn:exclusiveGateway id="Gw_Scalenie" />
    <bpmn:userTask id="Task_Dekretacja" name="Dekretacja pisma w EZD" />
    <bpmn:exclusiveGateway id="Gw_Wlasciwa" name="Czy pismo trafiło do właściwej jednostki?" />
    <bpmn:userTask id="Task_Korekta" name="Korekta przydziału w EZD" />
    <bpmn:parallelGateway id="Gw_Zlaczenie" />
    <bpmn:endEvent id="End_Przekazane" name="Pismo przekazane do załatwienia" />
    <bpmn:dataStoreReference id="DataStoreRef_EZD" name="System EZD" dataStoreRef="DataStore_EZD" />
    <bpmn:dataStoreReference id="DataStoreRef_Sklad" name="Skład chronologiczny" dataStoreRef="DataStore_Sklad" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Wplynelo" targetRef="Task_Rejestracja" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Rejestracja" targetRef="Gw_Rozwidlenie" />
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_Rozwidlenie" targetRef="Task_Sklad" />
    <bpmn:sequenceFlow id="F4" sourceRef="Gw_Rozwidlenie" targetRef="Task_Wstepna" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Wstepna" targetRef="Gw_Scalenie" />
    <bpmn:sequenceFlow id="F6" sourceRef="Gw_Scalenie" targetRef="Task_Dekretacja" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Dekretacja" targetRef="Gw_Wlasciwa" />
    <bpmn:sequenceFlow id="F8" name="nie" sourceRef="Gw_Wlasciwa" targetRef="Task_Korekta" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Korekta" targetRef="Gw_Scalenie" />
    <bpmn:sequenceFlow id="F10" name="tak" sourceRef="Gw_Wlasciwa" targetRef="Gw_Zlaczenie" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Sklad" targetRef="Gw_Zlaczenie" />
    <bpmn:sequenceFlow id="F12" sourceRef="Gw_Zlaczenie" targetRef="End_Przekazane" />
  </bpmn:process>
