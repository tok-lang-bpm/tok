      <bpmndi:BPMNShape id="wybor_di" bpmnElement="wybor">
        <dc:Bounds x="366" y="45" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="396" y="98" width="62" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decyzja_di" bpmnElement="decyzja">
        <dc:Bounds x="466" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="podzial_di" bpmnElement="podzial">
        <dc:Bounds x="616" y="45" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="646" y="98" width="68" height="35" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="korekta_di" bpmnElement="korekta">
        <dc:Bounds x="716" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sklad_di" bpmnElement="sklad">
