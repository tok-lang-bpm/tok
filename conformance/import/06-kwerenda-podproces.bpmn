<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Kwerenda" targetNamespace="https://codeberg.org/MarekDeja/ipm/diagramy/06">
  <bpmn:message id="Msg_Wniosek" name="Wniosek o kwerendę" />
  <bpmn:message id="Msg_Wycofanie" name="Wycofanie wniosku" />
  <bpmn:message id="Msg_Przedluzenie" name="Zawiadomienie o nowym terminie" />
  <bpmn:message id="Msg_Odpowiedz" name="Odpowiedź na kwerendę" />
  <bpmn:escalation id="Esc_Szersze" name="Kwerenda wymaga szerszych poszukiwań" escalationCode="SZERSZE" />
  <bpmn:collaboration id="Collaboration_Kwerenda">
    <bpmn:participant id="Participant_Archiwum" name="Archiwum" processRef="Process_Kwerenda" />
    <bpmn:participant id="Participant_Wnioskodawca" name="Wnioskodawca" />
    <bpmn:messageFlow id="MF_Wniosek" name="Wniosek" sourceRef="Participant_Wnioskodawca" targetRef="Start_Wniosek" messageRef="Msg_Wniosek" />
    <bpmn:messageFlow id="MF_Przedluzenie" name="Nowy termin" sourceRef="Task_Zawiadomienie" targetRef="Participant_Wnioskodawca" messageRef="Msg_Przedluzenie" />
    <bpmn:messageFlow id="MF_Odpowiedz" name="Odpowiedź" sourceRef="Task_Wyslanie" targetRef="Participant_Wnioskodawca" messageRef="Msg_Odpowiedz" />
    <bpmn:messageFlow id="MF_Wycofanie" name="Wycofanie" sourceRef="Participant_Wnioskodawca" targetRef="EventSub_Start" messageRef="Msg_Wycofanie" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Kwerenda" name="Kwerenda archiwalna" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Kwerenda">
      <bpmn:lane id="Lane_Kancelaria" name="Pracownik kancelarii">
        <bpmn:flowNodeRef>Start_Wniosek</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rejestracja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Wyslanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Wyslana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EventSub_Wycofanie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Archiwista" name="Archiwista">
        <bpmn:flowNodeRef>Sub_Poszukiwania</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Szersze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Odpowiedz</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kierownik" name="Kierownik oddziału">
        <bpmn:flowNodeRef>Task_NowyTermin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zawiadomienie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Zawiadomiony</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Wniosek" name="Wniosek wpłynął">
      <bpmn:messageEventDefinition id="Start_Wniosek_def" messageRef="Msg_Wniosek" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Rejestracja" name="Rejestracja wniosku" />
    <bpmn:subProcess id="Sub_Poszukiwania" name="Poszukiwania w zasobie">
      <bpmn:startEvent id="Sub_Start" name="Poszukiwania rozpoczęte" />
      <bpmn:userTask id="Sub_Task_Inwentarze" name="Przegląd inwentarzy i katalogów" />
      <bpmn:exclusiveGateway id="Sub_Gw_Odnalezione" name="Czy akta odnalezione w inwentarzach?" />
      <bpmn:intermediateThrowEvent id="Sub_Throw_Szersze" name="Zgłoszenie szerszych poszukiwań">
        <bpmn:escalationEventDefinition id="Sub_Throw_Szersze_def" escalationRef="Esc_Szersze" />
      </bpmn:intermediateThrowEvent>
      <bpmn:userTask id="Sub_Task_Pokrewne" name="Przeszukanie zespołów pokrewnych" />
      <bpmn:exclusiveGateway id="Sub_Gw_Scalenie" />
      <bpmn:userTask id="Sub_Task_Wyniki" name="Sporządzenie wyników kwerendy" />
      <bpmn:endEvent id="Sub_End" name="Wyniki gotowe" />
      <bpmn:sequenceFlow id="SF1" sourceRef="Sub_Start" targetRef="Sub_Task_Inwentarze" />
      <bpmn:sequenceFlow id="SF2" sourceRef="Sub_Task_Inwentarze" targetRef="Sub_Gw_Odnalezione" />
      <bpmn:sequenceFlow id="SF3" name="tak" sourceRef="Sub_Gw_Odnalezione" targetRef="Sub_Gw_Scalenie" />
      <bpmn:sequenceFlow id="SF4" name="nie" sourceRef="Sub_Gw_Odnalezione" targetRef="Sub_Throw_Szersze" />
      <bpmn:sequenceFlow id="SF5" sourceRef="Sub_Throw_Szersze" targetRef="Sub_Task_Pokrewne" />
      <bpmn:sequenceFlow id="SF6" sourceRef="Sub_Task_Pokrewne" targetRef="Sub_Gw_Scalenie" />
      <bpmn:sequenceFlow id="SF7" sourceRef="Sub_Gw_Scalenie" targetRef="Sub_Task_Wyniki" />
      <bpmn:sequenceFlow id="SF8" sourceRef="Sub_Task_Wyniki" targetRef="Sub_End" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Szersze" name="Szersze poszukiwania" attachedToRef="Sub_Poszukiwania" cancelActivity="false">
      <bpmn:escalationEventDefinition id="Boundary_Szersze_def" escalationRef="Esc_Szersze" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Task_NowyTermin" name="Wyznaczenie nowego terminu odpowiedzi" />
    <bpmn:sendTask id="Task_Zawiadomienie" name="Zawiadomienie wnioskodawcy o nowym terminie" messageRef="Msg_Przedluzenie" />
    <bpmn:endEvent id="End_Zawiadomiony" name="Wnioskodawca zawiadomiony" />
    <bpmn:userTask id="Task_Odpowiedz" name="Przygotowanie odpowiedzi" />
    <bpmn:sendTask id="Task_Wyslanie" name="Wysłanie odpowiedzi" messageRef="Msg_Odpowiedz" />
    <bpmn:endEvent id="End_Wyslana" name="Odpowiedź wysłana" />
    <bpmn:subProcess id="EventSub_Wycofanie" name="Wycofanie wniosku" triggeredByEvent="true">
      <bpmn:startEvent id="EventSub_Start" name="Wycofanie otrzymane">
        <bpmn:messageEventDefinition id="EventSub_Start_def" messageRef="Msg_Wycofanie" />
      </bpmn:startEvent>
      <bpmn:userTask id="EventSub_Task_Zamkniecie" name="Zamknięcie sprawy w rejestrze" />
      <bpmn:endEvent id="EventSub_End" name="Sprawa zamknięta" />
      <bpmn:sequenceFlow id="EF1" sourceRef="EventSub_Start" targetRef="EventSub_Task_Zamkniecie" />
      <bpmn:sequenceFlow id="EF2" sourceRef="EventSub_Task_Zamkniecie" targetRef="EventSub_End" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Wniosek" targetRef="Task_Rejestracja" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Rejestracja" targetRef="Sub_Poszukiwania" />
    <bpmn:sequenceFlow id="F3" sourceRef="Sub_Poszukiwania" targetRef="Task_Odpowiedz" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Odpowiedz" targetRef="Task_Wyslanie" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Wyslanie" targetRef="End_Wyslana" />
    <bpmn:sequenceFlow id="F6" sourceRef="Boundary_Szersze" targetRef="Task_NowyTermin" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_NowyTermin" targetRef="Task_Zawiadomienie" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Zawiadomienie" targetRef="End_Zawiadomiony" />
  </bpmn:process>
