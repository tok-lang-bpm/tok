        <bpmn:flowNodeRef>wyslanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>przesylka</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="system" name="System biblioteczny">
        <bpmn:flowNodeRef>rejestracja</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="potrzeba" name="Potrzeba książki" />
    <bpmn:userTask id="zamowienie" name="Złożenie zamówienia">
      <bpmn:dataOutputAssociation id="zamowienie-doa-1">
        <bpmn:targetRef>zam-zlozone</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="odbior" name="Odbiór książki" />
    <bpmn:endEvent id="wypozyczona" name="Książka wypożyczona" />
