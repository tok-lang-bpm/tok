<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Wspolpraca" targetNamespace="https://codeberg.org/MarekDeja/ipm/diagramy/04">
  <bpmn:message id="Msg_Zamowienie" name="Zamówienie" />
  <bpmn:message id="Msg_Przesylka" name="Przesyłka z egzemplarzem" />
  <bpmn:dataStore id="DataStore_Katalog" name="Katalog NUKAT" />
  <bpmn:dataStore id="DataStore_Rejestr" name="Rejestr wypożyczeń" />
  <bpmn:collaboration id="Collaboration_Wspolpraca">
    <bpmn:participant id="Participant_Biblioteka" name="Biblioteka uczelniana" processRef="Process_Wypozyczenie" />
    <bpmn:participant id="Participant_Udostepniajaca" name="Biblioteka udostępniająca" />
    <bpmn:messageFlow id="MF_Zamowienie" name="Zamówienie" sourceRef="Task_Wyslanie" targetRef="Participant_Udostepniajaca" messageRef="Msg_Zamowienie" />
    <bpmn:messageFlow id="MF_Przesylka" name="Przesyłka z egzemplarzem" sourceRef="Participant_Udostepniajaca" targetRef="Catch_Egzemplarz" messageRef="Msg_Przesylka" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Wypozyczenie" name="Wypożyczenie międzybiblioteczne" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Czytelnik" name="Czytelnik">
        <bpmn:flowNodeRef>Start_Potrzeba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Zlozenie</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bibliotekarz" name="Bibliotekarz wypożyczalni międzybibliotecznej">
        <bpmn:flowNodeRef>Task_Sprawdzenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Wyslanie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Egzemplarz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Wypozyczenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Wypozyczona</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="System biblioteczny">
        <bpmn:flowNodeRef>Task_Rejestracja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Powiadomienie</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="DataObject_Zamowienie" name="Zamówienie" />
    <bpmn:dataObjectReference id="DOR_Zamowienie_zlozone" name="Zamówienie" dataObjectRef="DataObject_Zamowienie">
      <bpmn:dataState id="DOR_Zamowienie_zlozone_state" name="złożone" />
    </bpmn:dataObjectReference>
    <bpmn:dataObjectReference id="DOR_Zamowienie_wyslane" name="Zamówienie" dataObjectRef="DataObject_Zamowienie">
      <bpmn:dataState id="DOR_Zamowienie_wyslane_state" name="wysłane" />
    </bpmn:dataObjectReference>
    <bpmn:dataStoreReference id="DSR_Katalog" name="Katalog NUKAT" dataStoreRef="DataStore_Katalog" />
    <bpmn:dataStoreReference id="DSR_Rejestr" name="Rejestr wypożyczeń" dataStoreRef="DataStore_Rejestr" />
    <bpmn:startEvent id="Start_Potrzeba" name="Potrzeba książki" />
    <bpmn:userTask id="Task_Zlozenie" name="Złożenie zamówienia">
      <bpmn:dataOutputAssociation id="DOA_Zlozenie">
        <bpmn:targetRef>DOR_Zamowienie_zlozone</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Rejestracja" name="Rejestracja zamówienia">
      <bpmn:property id="Task_Rejestracja_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Rejestracja">
        <bpmn:sourceRef>DOR_Zamowienie_zlozone</bpmn:sourceRef>
        <bpmn:targetRef>Task_Rejestracja_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DOA_Rejestracja">
        <bpmn:targetRef>DSR_Rejestr</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Sprawdzenie" name="Sprawdzenie katalogów">
      <bpmn:property id="Task_Sprawdzenie_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Sprawdzenie">
        <bpmn:sourceRef>DSR_Katalog</bpmn:sourceRef>
        <bpmn:targetRef>Task_Sprawdzenie_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_Wyslanie" name="Wysłanie zamówienia" messageRef="Msg_Zamowienie">
      <bpmn:dataOutputAssociation id="DOA_Wyslanie">
        <bpmn:targetRef>DOR_Zamowienie_wyslane</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Catch_Egzemplarz" name="Egzemplarz otrzymany">
      <bpmn:messageEventDefinition id="Catch_Egzemplarz_def" messageRef="Msg_Przesylka" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_Powiadomienie" name="Powiadomienie czytelnika" />
    <bpmn:userTask id="Task_Wypozyczenie" name="Wypożyczenie egzemplarza czytelnikowi">
      <bpmn:dataOutputAssociation id="DOA_Wypozyczenie">
        <bpmn:targetRef>DSR_Rejestr</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Wypozyczona" name="Książka wypożyczona" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Potrzeba" targetRef="Task_Zlozenie" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Zlozenie" targetRef="Task_Rejestracja" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Rejestracja" targetRef="Task_Sprawdzenie" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Sprawdzenie" targetRef="Task_Wyslanie" />
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Wyslanie" targetRef="Catch_Egzemplarz" />
    <bpmn:sequenceFlow id="F6" sourceRef="Catch_Egzemplarz" targetRef="Task_Powiadomienie" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Powiadomienie" targetRef="Task_Wypozyczenie" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_Wypozyczenie" targetRef="End_Wypozyczona" />
  </bpmn:process>
