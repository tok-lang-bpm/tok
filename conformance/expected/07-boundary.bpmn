<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" exporter="tok" exporterVersion="0.1.0" id="definitions" name="Wyjątki" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_Zwrot" name="Zwrot" />
  <bpmn:signal id="Signal_Zamkniecie_czytelni" name="Zamknięcie czytelni" />
  <bpmn:error errorCode="ZAPIS" id="Error_Blad_zapisu" name="Błąd zapisu" />
  <bpmn:escalation escalationCode="T1" id="Escalation_Termin" name="Termin" />
  <bpmn:process id="process" isExecutable="false" name="Wyjątki">
    <bpmn:startEvent id="s" />
    <bpmn:userTask id="o" name="Odbiór książki" />
    <bpmn:boundaryEvent attachedToRef="o" id="b1" name="Minęło 7 dni">
      <bpmn:timerEventDefinition id="b1-def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent attachedToRef="o" cancelActivity="false" id="b2" name="Przypomnienie">
      <bpmn:timerEventDefinition id="b2-def">
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R3/P2D</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="r" name="Rejestracja wypożyczenia" />
    <bpmn:boundaryEvent attachedToRef="r" id="b3" name="Błąd zapisu">
      <bpmn:errorEventDefinition errorRef="Error_Blad_zapisu" id="b3-def" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent attachedToRef="r" cancelActivity="false" id="b4" name="Eskalacja">
      <bpmn:escalationEventDefinition escalationRef="Escalation_Termin" id="b4-def" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="x" name="Sygnał">
      <bpmn:signalEventDefinition id="x-def" signalRef="Signal_Zamkniecie_czytelni" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="e" />
    <bpmn:endEvent id="e2" name="Zwrot">
      <bpmn:messageEventDefinition id="e2-def" messageRef="Message_Zwrot" />
    </bpmn:endEvent>
    <bpmn:endEvent id="e3" name="Błąd">
      <bpmn:errorEventDefinition errorRef="Error_Blad_zapisu" id="e3-def" />
    </bpmn:endEvent>
    <bpmn:endEvent id="e4">
      <bpmn:escalationEventDefinition escalationRef="Escalation_Termin" id="e4-def" />
    </bpmn:endEvent>
    <bpmn:endEvent id="e5">
      <bpmn:signalEventDefinition id="e5-def" signalRef="Signal_Zamkniecie_czytelni" />
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="d" name="Data">
      <bpmn:timerEventDefinition id="d-def">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">2027-01-15T09:00</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="f-s-o" sourceRef="s" targetRef="o" />
    <bpmn:sequenceFlow id="f-o-r" sourceRef="o" targetRef="r" />
    <bpmn:sequenceFlow id="f-r-x" sourceRef="r" targetRef="x" />
    <bpmn:sequenceFlow id="f-x-e" sourceRef="x" targetRef="e" />
    <bpmn:sequenceFlow id="f-b1-e2" sourceRef="b1" targetRef="e2" />
    <bpmn:sequenceFlow id="f-b2-e4" sourceRef="b2" targetRef="e4" />
    <bpmn:sequenceFlow id="f-b3-e3" sourceRef="b3" targetRef="e3" />
    <bpmn:sequenceFlow id="f-b4-e5" sourceRef="b4" targetRef="e5" />
  </bpmn:process>
</bpmn:definitions>
