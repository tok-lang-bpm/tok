{
  "id": "f-start",
  "type": "default",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.10.0",
  "exporter": {
    "name": "tok",
    "version": "0.1.0"
  },
  "components": [
    {
      "type": "text",
      "id": "Text_1",
      "text": "## Propozycja zakupu"
    },
    {
      "type": "textfield",
      "id": "Field_tytul",
      "key": "tytul",
      "label": "Tytuł",
      "validate": {
        "required": true
      }
    },
    {
      "type": "number",
      "id": "Field_cena",
      "key": "cena",
      "label": "Cena",
      "validate": {
        "min": 0,
        "max": 1000
      }
    },
    {
      "type": "select",
      "id": "Field_rodzaj",
      "key": "rodzaj",
      "label": "Rodzaj",
      "values": [
        {
          "label": "książka drukowana",
          "value": "drukowana"
        },
        {
          "label": "e-book",
          "value": "e-book"
        }
      ],
      "defaultValue": "drukowana"
    }
  ],
  "schemaVersion": 18
}
