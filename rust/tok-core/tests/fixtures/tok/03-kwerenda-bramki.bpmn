<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definitions" name="Kwerenda w archiwum" targetNamespace="http://bpmn.io/schema/bpmn" exporter="tok" exporterVersion="0.1">
  <bpmn:message id="Message_Odpowiedz" name="Odpowiedź" />
  <bpmn:process id="process" name="Kwerenda w archiwum" isExecutable="false">
    <bpmn:startEvent id="wplynela" name="Wniosek o kwerendę wpłynął" />
    <bpmn:userTask id="ocena" name="Ocena wniosku" />
    <bpmn:exclusiveGateway id="kompletny" name="Czy wniosek kompletny?" default="f-kompletny-wezwanie" />
    <bpmn:userTask id="wezwanie" name="Wezwanie do uzupełnienia" />
    <bpmn:parallelGateway id="poszukiwania" />
    <bpmn:userTask id="inwentarz" name="Przeszukanie inwentarzy" />
    <bpmn:userTask id="ewidencja" name="Przeszukanie ewidencji kwerend" />
    <bpmn:parallelGateway id="wyniki" />
    <bpmn:userTask id="odpowiedz" name="Opracowanie odpowiedzi" />
    <bpmn:inclusiveGateway id="forma" name="Jak przekazać odpowiedź?" default="f-forma-osobiscie" />
    <bpmn:sendTask id="email" name="Wysłanie odpowiedzi e-mailem" messageRef="Message_Odpowiedz" />
    <bpmn:sendTask id="list" name="Wysłanie odpowiedzi listem" messageRef="Message_Odpowiedz" />
    <bpmn:manualTask id="osobiscie" name="Wydanie odpowiedzi w kancelarii" />
    <bpmn:inclusiveGateway id="przekazano" />
    <bpmn:endEvent id="zakonczona" name="Kwerenda zakończona" />
    <bpmn:sequenceFlow id="f-wplynela-ocena" sourceRef="wplynela" targetRef="ocena" />
    <bpmn:sequenceFlow id="f-ocena-kompletny" sourceRef="ocena" targetRef="kompletny" />
    <bpmn:sequenceFlow id="f-kompletny-poszukiwania" name="tak" sourceRef="kompletny" targetRef="poszukiwania">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">kompletny = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-kompletny-wezwanie" name="nie" sourceRef="kompletny" targetRef="wezwanie" />
    <bpmn:sequenceFlow id="f-wezwanie-ocena" sourceRef="wezwanie" targetRef="ocena" />
    <bpmn:sequenceFlow id="f-poszukiwania-inwentarz" sourceRef="poszukiwania" targetRef="inwentarz" />
    <bpmn:sequenceFlow id="f-inwentarz-wyniki" sourceRef="inwentarz" targetRef="wyniki" />
    <bpmn:sequenceFlow id="f-poszukiwania-ewidencja" sourceRef="poszukiwania" targetRef="ewidencja" />
    <bpmn:sequenceFlow id="f-ewidencja-wyniki" sourceRef="ewidencja" targetRef="wyniki" />
    <bpmn:sequenceFlow id="f-wyniki-odpowiedz" sourceRef="wyniki" targetRef="odpowiedz" />
    <bpmn:sequenceFlow id="f-odpowiedz-forma" sourceRef="odpowiedz" targetRef="forma" />
    <bpmn:sequenceFlow id="f-forma-email" name="e-mail" sourceRef="forma" targetRef="email">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">email != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-forma-list" name="list" sourceRef="forma" targetRef="list">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">adres != null and kopie = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-forma-osobiscie" name="osobiście" sourceRef="forma" targetRef="osobiscie" />
    <bpmn:sequenceFlow id="f-email-przekazano" sourceRef="email" targetRef="przekazano" />
    <bpmn:sequenceFlow id="f-list-przekazano" sourceRef="list" targetRef="przekazano" />
    <bpmn:sequenceFlow id="f-osobiscie-przekazano" sourceRef="osobiscie" targetRef="przekazano" />
    <bpmn:sequenceFlow id="f-przekazano-zakonczona" sourceRef="przekazano" targetRef="zakonczona" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process">
