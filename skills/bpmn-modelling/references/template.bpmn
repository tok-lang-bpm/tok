<?xml version="1.0" encoding="UTF-8"?>
<!--
  Model skeleton: an organisation with lanes + an external participant (black-box pool).
  Copy it, change the names and identifiers, add the elements. Do not add a bpmndi section:
  the coordinates are generated by the tok command (tok bpmn).
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://example.org/process">

  <!-- Declarations: messages, signals, errors, escalations, data stores -->
  <bpmn:message id="Msg_Request" name="Request"/>
  <bpmn:message id="Msg_Reply" name="Reply"/>

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Organisation" name="Organisation" processRef="Process_1"/>
    <bpmn:participant id="Participant_External" name="External partner"/>
    <bpmn:messageFlow id="MF_Reply" name="Reply" sourceRef="Task_2" targetRef="Participant_External" messageRef="Msg_Reply"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_1" name="Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_A" name="Role A">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_B" name="Role B">
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_1" name="1. Request received">
      <bpmn:messageEventDefinition id="Start_1_def" messageRef="Msg_Request"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_1" name="1. Registering the request"/>
    <bpmn:sendTask id="Task_2" name="2. Sending the reply" messageRef="Msg_Reply"/>
    <bpmn:endEvent id="End_3" name="3. End"/>

    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Task_1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_1" targetRef="Task_2"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_2" targetRef="End_3"/>
  </bpmn:process>
</bpmn:definitions>
